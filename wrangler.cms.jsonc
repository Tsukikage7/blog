{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog-cms",
  "account_id": "f08770d5c92bef6310b2e5dbf2ac2286",
  "main": "src/cms/worker.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "cms.tsukikage7.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/admin", "/admin/*"],
    "not_found_handling": "404-page",
  },
  "d1_databases": [
    {
      "binding": "CMS_DB",
      "database_name": "blog-cms",
      "database_id": "0275ff7f-d7be-497d-b717-3b95e83f395f",
      "migrations_dir": "migrations/cms",
    },
  ],
  "r2_buckets": [{ "binding": "CMS_MEDIA", "bucket_name": "assets" }],
  "vars": {
    "CMS_GITHUB_REPO": "Tsukikage7/blog",
    "CMS_GITHUB_BRANCH": "main",
    "CMS_SITE_URL": "https://tsukikage7.com",
    "CMS_MEDIA_URL": "https://assets.tsukikage7.com",
    "CMS_CF_ACCOUNT_ID": "f08770d5c92bef6310b2e5dbf2ac2286",
    "CMS_CF_WORKER_NAME": "blog",
    "CMS_CF_SITE_TAG": "90dd0c6ff43546d2b60f629621764bb2",
    "CMS_ACCESS_TEAM_DOMAIN": "tsukikage.cloudflareaccess.com",
    "CMS_ACCESS_AUD": "3930d1258d3077a7cb28933309d2a039f670e05229b03273d17682e3d04c560e",
    "CMS_ALLOWED_EMAILS": "chongyanovo@gmail.com",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": { "enabled": false },
  },
}
