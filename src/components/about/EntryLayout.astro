---
import BaseLayout from "@components/base/BaseLayout.astro";
import Breadcrumbs from "@components/common/Breadcrumbs.astro";
import type { AboutEntry } from "@/types";
import { render } from "astro:content";
import { Image } from "astro:assets";
import { AVATAR_IMAGE } from "@lib/config";
import { avatarImage } from "@lib/imageAssets";
import { FaGithub } from "react-icons/fa";
import type { IconType } from "react-icons";
import {
  HiOutlineAcademicCap,
  HiOutlineArrowDown,
  HiOutlineArrowUpRight,
  HiOutlineBookOpen,
  HiOutlineBolt,
  HiOutlineBriefcase,
  HiOutlineChartBar,
  HiOutlineCircleStack,
  HiOutlineCodeBracket,
  HiOutlineLightBulb,
  HiOutlineMapPin,
  HiOutlineMusicalNote,
  HiOutlinePencilSquare,
  HiOutlineShare,
  HiOutlineWrenchScrewdriver,
} from "react-icons/hi2";
import TechnologyLink from "./TechnologyLink.astro";
import TechnologyText from "./TechnologyText.astro";

const iconMap: Record<string, IconType> = {
  wrench: HiOutlineWrenchScrewdriver,
  database: HiOutlineCircleStack,
  bolt: HiOutlineBolt,
  chart: HiOutlineChartBar,
  network: HiOutlineShare,
  code: HiOutlineCodeBracket,
};

interface Props {
  entry: AboutEntry;
}

const { entry } = Astro.props;
const {
  title,
  description,
  image,
  imageAlt,
  info,
  skillCategories,
  education,
  experience,
  openSource,
  social,
} = entry.data;
const destinations = [
  {
    title: "文章",
    description: "把问题想明白，再写下来。",
    href: "/blog/",
    icon: HiOutlineBookOpen,
  },
  {
    title: "笔记",
    description: "留住零散的发现与灵感。",
    href: "/notes/",
    icon: HiOutlineLightBulb,
  },
  {
    title: "创作",
    description: "故事、散文，还有一些诗。",
    href: "/writings/",
    icon: HiOutlinePencilSquare,
  },
  {
    title: "音乐",
    description: "挑一首歌，慢慢听。",
    href: "/music/",
    icon: HiOutlineMusicalNote,
  },
];
const { Content } = await render(entry);
const imageSrc = image
  ? typeof image === "string"
    ? image
    : image.src
  : undefined;
---

<BaseLayout title={title} description={description} image={imageSrc}>
  <section class="site-container about-page">
    <Breadcrumbs title={title} className="text-xs text-muted-foreground" />
    <section
      id="author"
      class="about-intro"
      aria-labelledby="about-title"
      data-about-reveal
    >
      <div class="intro-eyebrow">
        <span></span> 很高兴，在这里遇见你
      </div>
      <div class="intro-layout">
        {image && (
          <div class="avatar-frame">
            {typeof image === "string" ? (
              <img
                class="about-avatar"
                src={image === AVATAR_IMAGE ? avatarImage(144) : image}
                srcset={
                  image === AVATAR_IMAGE
                    ? `${avatarImage(144)} 1x, ${avatarImage(288)} 2x`
                    : undefined
                }
                alt={imageAlt || "作者头像"}
                width="144"
                height="144"
                loading="eager"
              />
            ) : (
              <Image
                class="about-avatar"
                src={image}
                alt={imageAlt || "作者头像"}
                width={144}
                height={144}
                loading="eager"
              />
            )}
          </div>
        )}
        <div class="min-w-0 flex-1">
          <p class="intro-handle">Tsukikage / 韩信</p>
          <h1 id="about-title" class="about-title">
            {info?.name || title}
          </h1>
          {info?.title && <p class="about-tagline">{info.title}</p>}
          {info?.summary && <p class="about-summary">{info.summary}</p>}
          <div class="intro-actions">
            <a class="resume-link" href="#resume">
              了解我的工作 <HiOutlineArrowDown aria-hidden="true" />
            </a>
            {social?.email && (
              <a class="contact-link" href={`mailto:${social.email}`}>
                写封邮件 <HiOutlineArrowUpRight aria-hidden="true" />
              </a>
            )}
          </div>
          {info?.location && (
            <p class="about-location">
              <HiOutlineMapPin aria-hidden="true" />
              {info.location}
            </p>
          )}
        </div>
      </div>
      <div class="intro-footnote" aria-label="兴趣与方向">
        <span>生活里，读书、听歌、写字。</span>
        <span>工作中，写代码、解决问题。</span>
      </div>
    </section>
    <section
      id="personal-introduction"
      class="about-body"
      aria-label="个人介绍"
    >
      <div class="narrative-card" data-about-reveal>
        <div class="prose prose-site prose-base max-w-none">
          <Content />
        </div>
      </div>
      <aside class="about-aside" aria-labelledby="explore-title">
        <div class="explore-heading" data-about-reveal>
          <span class="section-eyebrow">这个小小的站点</span>
          <h2 id="explore-title">随处逛逛</h2>
        </div>
        <div class="destination-grid">
          {destinations.map(({ title, description, href, icon: Icon }) => (
            <a class="destination-card" href={href} data-about-reveal>
              <span class="destination-icon">
                <Icon aria-hidden="true" />
              </span>
              <HiOutlineArrowUpRight
                className="destination-arrow"
                aria-hidden="true"
              />
              <h3>{title}</h3>
              <p>{description}</p>
            </a>
          ))}
        </div>
        <p class="aside-note" data-about-reveal>
          不急着赶路，也留一点时间给好奇心。
        </p>
      </aside>
    </section>
    <section id="resume" class="about-resume" aria-labelledby="resume-title">
      <div class="resume-heading" data-about-reveal>
        <div>
          <p class="section-eyebrow">生活的另一面</p>
          <h2
            id="resume-title"
            class="section-title text-3xl font-semibold text-foreground"
          >
            我做的事
          </h2>
        </div>
        <p>一些技术积累，也是一段持续学习的旅程。</p>
      </div>
      <nav class="about-navigation" aria-label="关于页章节">
        <a href="#skills">专业技能</a>
        <a href="#education">教育背景</a>
        <a href="#experience">工作经历</a>
        <a href="#open-source">开源贡献</a>
      </nav>
      <div class="about-sections">
        <!-- 技能分类 -->
        {skillCategories && skillCategories.length > 0 && (
          <div id="skills">
            <h2 class="section-title text-2xl font-medium text-foreground mb-6 flex items-center gap-3">
              <HiOutlineLightBulb className="text-2xl text-primary" /> 专业技能
            </h2>
            <div class="skills-grid">
              {skillCategories.map((category) => {
                const CategoryIcon =
                  iconMap[category.icon || ""] || HiOutlineCodeBracket;
                return (
                  <section class="about-panel" data-about-reveal>
                    <h3 class="skill-category-title mb-3 flex items-center gap-2 border-b border-border/50 pb-3 text-base font-semibold text-foreground">
                      <CategoryIcon className="text-lg text-primary" />
                      {category.name}
                    </h3>
                    <ul class="technology-list">
                      {category.skills
                        .flatMap((row) => row.split(" / "))
                        .map((skill) => (
                          <li>
                            <TechnologyLink name={skill} />
                          </li>
                        ))}
                    </ul>
                  </section>
                );
              })}
            </div>
          </div>
        )}

        <!-- 教育背景 -->
        {education && education.length > 0 && (
          <div id="education">
            <h2 class="section-title text-2xl font-medium text-foreground mb-6 flex items-center gap-3">
              <HiOutlineAcademicCap className="text-2xl text-primary" />{" "}
              教育背景
            </h2>
            <section class="about-panel" data-about-reveal>
              {education.map((edu, index) => (
                <div
                  class={`flex flex-col md:flex-row md:items-center justify-between ${index > 0 ? "mt-4 pt-4 border-t border-border/30" : ""}`}
                >
                  <div class="flex items-start gap-4">
                    <a
                      class="organization-logo school-logo"
                      href="https://www.nuist.edu.cn/"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="南京信息工程大学官网"
                    >
                      {edu.logo ? (
                        <img
                          src={edu.logo}
                          alt={`${edu.school}校标`}
                          width="48"
                          height="48"
                          loading="lazy"
                        />
                      ) : (
                        <HiOutlineAcademicCap className="text-primary text-xl" />
                      )}
                    </a>
                    <div>
                      <div class="flex items-center gap-2 flex-wrap">
                        <span class="font-bold text-lg text-foreground">
                          {edu.school}
                        </span>
                        {edu.badge && (
                          <span class="px-2.5 py-1 rounded text-sm font-medium bg-muted/10 text-muted-foreground border border-border/20">
                            {edu.badge}
                          </span>
                        )}
                      </div>
                      <div class="text-base text-muted-foreground mt-1">
                        {edu.degree}
                      </div>
                    </div>
                  </div>
                  <div class="text-base text-muted-foreground mt-2 md:mt-0 md:text-right">
                    {edu.period && <div>{edu.period}</div>}
                    {edu.location && (
                      <div class="text-sm opacity-70">{edu.location}</div>
                    )}
                  </div>
                </div>
              ))}
            </section>
          </div>
        )}

        <!-- 工作经历 -->
        {experience && experience.length > 0 && (
          <div id="experience">
            <h2 class="section-title text-2xl font-medium text-foreground mb-6 flex items-center gap-3">
              <HiOutlineBriefcase className="text-2xl text-primary" /> 工作经历
            </h2>
            <div class="space-y-3">
              {experience.map((exp) => (
                <section class="about-panel" data-about-reveal>
                  <div class="flex flex-col md:flex-row md:items-start justify-between mb-3">
                    <div class="flex items-start gap-4">
                      {exp.logo && (
                        <a
                          class="organization-logo"
                          href="https://www.ucloud.cn/"
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label="优刻得官网"
                        >
                          <img
                            src={exp.logo}
                            alt={`${exp.company}标志`}
                            width="48"
                            height="48"
                            loading="lazy"
                          />
                        </a>
                      )}
                      <div class="min-w-0">
                        <h3 class="font-bold text-xl text-foreground">
                          {exp.title}
                        </h3>
                        <div class="text-primary font-medium text-lg">
                          {exp.company}
                        </div>
                      </div>
                    </div>
                    <div class="text-base text-muted-foreground mt-1 md:mt-0 md:text-right">
                      <div>{exp.period}</div>
                      {exp.location && (
                        <div class="text-sm opacity-70">{exp.location}</div>
                      )}
                    </div>
                  </div>
                  {exp.description && (
                    <p class="text-base text-muted-foreground mb-3">
                      <TechnologyText text={exp.description} />
                    </p>
                  )}
                  {exp.highlights && exp.highlights.length > 0 && (
                    <ul class="space-y-2">
                      {exp.highlights.map((highlight) => (
                        <li class="flex items-start gap-2 text-base text-muted-foreground">
                          <span class="w-1.5 h-1.5 rounded-full bg-primary mt-2 shrink-0"></span>
                          <span>
                            <TechnologyText text={highlight} />
                          </span>
                        </li>
                      ))}
                    </ul>
                  )}
                </section>
              ))}
            </div>
          </div>
        )}

        <!-- 开源项目 -->
        {openSource && openSource.length > 0 && (
          <div id="open-source">
            <h2 class="section-title text-2xl font-medium text-foreground mb-6 flex items-center gap-3">
              <HiOutlineCodeBracket className="text-2xl text-primary" />{" "}
              开源贡献
            </h2>
            <div class="space-y-3">
              {openSource.map((project) => (
                <section class="about-panel" data-about-reveal>
                  <div class="contribution-heading">
                    <div class="flex min-w-0 items-start gap-4">
                      <a
                        class="organization-logo"
                        href={project.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${project.name}项目主页`}
                      >
                        {project.logo ? (
                          <img
                            src={project.logo}
                            alt={`${project.name}标志`}
                            width="32"
                            height="32"
                            loading="lazy"
                          />
                        ) : (
                          <FaGithub aria-hidden="true" />
                        )}
                      </a>
                      <div class="min-w-0">
                        <h3 class="font-bold text-lg text-foreground flex items-center gap-2">
                          {project.url ? (
                            <a
                              href={project.url}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="hover:text-primary transition-colors"
                            >
                              {project.name}
                            </a>
                          ) : (
                            project.name
                          )}
                        </h3>
                        <span class="mt-1 inline-flex items-center rounded bg-primary/10 px-2 py-1 text-xs font-medium text-primary">
                          {project.role}
                        </span>
                      </div>
                    </div>
                    <span class="shrink-0 text-sm text-muted-foreground">
                      {project.period}
                    </span>
                  </div>
                  {project.description && (
                    <p class="text-base text-muted-foreground mb-3">
                      <TechnologyText text={project.description} />
                    </p>
                  )}
                  {project.contributions &&
                    project.contributions.length > 0 && (
                      <ul class="space-y-1.5">
                        {project.contributions.map((contribution) => (
                          <li class="flex items-start gap-2 text-sm leading-6 text-muted-foreground">
                            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>
                            <span>
                              <TechnologyText text={contribution} />
                            </span>
                          </li>
                        ))}
                      </ul>
                    )}
                  {project.links && project.links.length > 0 && (
                    <ul
                      class="contribution-links"
                      aria-label={`${project.name}贡献记录`}
                    >
                      {project.links.map((link) => (
                        <li>
                          <a
                            href={link.url}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {link.label}
                          </a>
                          <span
                            class="contribution-status"
                            data-status={link.status}
                          >
                            {link.status}
                          </span>
                        </li>
                      ))}
                    </ul>
                  )}
                </section>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  </section>
</BaseLayout>

<script>
  function setupAboutMotion() {
    const page = document.querySelector(".about-page");
    if (!page || window.matchMedia("(prefers-reduced-motion: reduce)").matches)
      return;

    // 默认显示内容，仅在进入视口时播放一次，脚本失败也不会隐藏正文。
    const animations = new Set<Animation>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries
          .filter((entry) => entry.isIntersecting)
          .forEach((entry, index) => {
            observer.unobserve(entry.target);
            const animation = entry.target.animate(
              [
                { opacity: 0, transform: "translateY(22px)" },
                { opacity: 1, transform: "translateY(0)" },
              ],
              {
                duration: 620,
                delay: Math.min(index * 75, 225),
                easing: "cubic-bezier(0.22, 1, 0.36, 1)",
                fill: "backwards",
              },
            );
            animations.add(animation);
            animation.onfinish = () => animations.delete(animation);
          });
      },
      { threshold: 0.08 },
    );

    page
      .querySelectorAll("[data-about-reveal]")
      .forEach((element) => observer.observe(element));
    document.addEventListener(
      "astro:before-swap",
      () => {
        observer.disconnect();
        animations.forEach((animation) => animation.cancel());
      },
      { once: true },
    );
  }

  document.addEventListener("astro:page-load", setupAboutMotion);
</script>

<style>
  .about-page {
    --about-radius: 22px;
    padding-block: 36px 48px;
  }
  .about-intro {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: 28px;
    padding: clamp(24px, 4vw, 48px);
    border: 1px solid hsl(var(--primary) / 0.18);
    border-radius: 28px;
    background:
      radial-gradient(
        ellipse at 95% 10%,
        hsl(var(--primary) / 0.12),
        transparent 65%
      ),
      hsl(var(--card));
    box-shadow: 0 16px 48px -32px hsl(var(--foreground) / 0.2);
  }
  .about-intro::before {
    position: absolute;
    z-index: -1;
    top: -170px;
    right: -90px;
    width: 500px;
    height: 500px;
    border: 1px solid hsl(var(--primary) / 0.1);
    border-radius: 50%;
    box-shadow:
      0 0 0 40px hsl(var(--primary) / 0.025),
      0 0 0 80px hsl(var(--primary) / 0.025);
    content: "";
    pointer-events: none;
  }
  .intro-eyebrow,
  .section-eyebrow {
    color: hsl(var(--muted-foreground));
    font-size: 12px;
    letter-spacing: 0.08em;
  }
  .intro-eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 32px;
  }
  .intro-eyebrow span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: hsl(var(--primary));
    box-shadow: 0 0 0 4px hsl(var(--primary) / 0.09);
  }
  .intro-layout {
    display: flex;
    align-items: center;
    gap: 48px;
  }
  .avatar-frame {
    order: 2;
    flex-shrink: 0;
    padding: 9px;
    border: 1px solid hsl(var(--primary) / 0.2);
    border-radius: 32px;
    background: hsl(var(--card) / 0.75);
    box-shadow: 0 12px 28px -16px hsl(var(--primary) / 0.3);
    transform: rotate(5deg);
    transition: transform 350ms ease;
  }
  .avatar-frame:hover {
    transform: rotate(0deg) translateY(-4px);
  }
  .about-avatar {
    width: 154px;
    height: 154px;
    border-radius: 24px;
    object-fit: cover;
  }
  .intro-handle {
    margin-bottom: 10px;
    color: hsl(var(--primary));
    font-size: 12px;
    letter-spacing: 0.06em;
  }
  .about-title {
    margin-bottom: 12px;
    font-family: var(--font-editorial);
    font-size: clamp(40px, 5vw, 60px);
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.035em;
  }
  .about-tagline {
    margin-bottom: 14px;
    font-family: var(--font-editorial);
    font-size: clamp(20px, 2.5vw, 26px);
  }
  .about-summary {
    max-width: 34em;
    line-height: 1.9;
    color: hsl(var(--muted-foreground));
    text-wrap: pretty;
  }
  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-block: 24px 18px;
  }
  .resume-link,
  .contact-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 44px;
    font-size: 13px;
    font-weight: 500;
    transition:
      transform 220ms ease,
      background-color 220ms ease;
  }
  .resume-link {
    padding: 10px 18px;
    border-radius: 10px;
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
  }
  .resume-link:hover {
    transform: translateY(-2px);
    background: hsl(var(--primary) / 0.88);
  }
  .contact-link {
    color: hsl(var(--primary));
  }
  .contact-link:hover {
    transform: translateX(3px);
  }
  .resume-link:active,
  .destination-card:active {
    transform: translateY(1px);
  }
  .intro-actions :global(svg) {
    width: 16px;
    height: 16px;
  }
  .about-location {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: hsl(var(--muted-foreground));
  }
  .about-location :global(svg) {
    width: 14px;
    height: 14px;
  }
  .intro-footnote {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid hsl(var(--primary) / 0.12);
    color: hsl(var(--muted-foreground));
    font-size: 12px;
  }
  .about-body {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    align-items: start;
    gap: 24px;
    padding-block: 28px 64px;
  }
  .narrative-card {
    min-width: 0;
    padding: clamp(24px, 3vw, 36px);
    border: 1px solid hsl(var(--border) / 0.7);
    border-radius: var(--about-radius);
    background: hsl(var(--card));
  }
  .narrative-card :global(h2) {
    margin-top: 1.8em;
    padding-bottom: 0;
    border: 0;
    font-family: var(--font-editorial);
    font-size: 23px;
  }
  .narrative-card :global(h2:first-child) {
    margin-top: 0;
  }
  .narrative-card :global(p) {
    line-height: 1.95;
    font-size: 14px;
    text-wrap: pretty;
  }
  .narrative-card :global(p:last-child) {
    margin-bottom: 0;
  }
  .about-aside {
    padding-top: 14px;
  }
  .explore-heading {
    margin-bottom: 20px;
    padding-inline: 4px;
  }
  .explore-heading h2 {
    margin-top: 6px;
    font-family: var(--font-editorial);
    font-size: 26px;
  }
  .destination-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .destination-card {
    position: relative;
    min-width: 0;
    padding: 20px 18px;
    border: 1px solid hsl(var(--border) / 0.6);
    border-radius: 16px;
    background: hsl(var(--card));
    transition:
      transform 250ms ease,
      border-color 250ms ease,
      box-shadow 250ms ease,
      background-color 250ms ease;
  }
  .destination-card:nth-child(2),
  .destination-card:nth-child(3) {
    background: hsl(var(--primary) / 0.045);
  }
  .destination-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
