---
import { FaGithub } from "react-icons/fa";
import { getEntriesBatch } from "@lib/contentParser";
import { buildActivityCalendar } from "@lib/activityCalendar";
import snapshot from "../../data/github-activity.json";

const today = new Date().toISOString().slice(0, 10);
const available = snapshot.year === Number(today.slice(0, 4));
const entries = await getEntriesBatch(["blog", "notes", "writings"]);
const dates = entries.flatMap((entry) => {
  if (!entry.data.created) return [];
  const date = new Date(entry.data.created);
  return Number.isNaN(date.getTime()) ? [] : [date.toISOString().slice(0, 10)];
});
const { year, weeks, months, stats } = buildActivityCalendar(
  today,
  dates,
  available ? snapshot.days : [],
);
const githubUrl = `https://github.com/${snapshot.username}?tab=overview&from=${year}-01-01&to=${year}-12-31`;
const syncedDate = snapshot.fetchedAt.slice(0, 10);
---

<div class="activity-calendar" style={`--week-count: ${weeks.length}`}>
  <div class="record-heading">
    <a
      class="github-profile"
      href={githubUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      <FaGithub aria-hidden="true" size={16} />
      <span>{snapshot.username}</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
  <div
    class="calendar-wrapper"
    tabindex="0"
    role="region"
    aria-label={`${year} 年活动日历，可横向滚动；每格一天`}
  >
    <div class="calendar-main">
      <div class="month-labels" aria-hidden="true">
        {months.map((month) => (
          <span style={`grid-column: ${month.column} / span 3`}>
            {month.name}
          </span>
        ))}
      </div>
      <div
        class="calendar-grid"
        role="img"
        aria-label={`${year} 年共 ${stats.total} 次记录，${stats.activeDays} 个活跃日`}
      >
        {weeks.map((week) => (
          <div class="week-column">
            {week.map((day) => (
              <span
                class:list={[
                  "calendar-day",
                  { outside: day.outside, future: day.future },
                ]}
                data-level={day.level}
                title={
                  day.outside
                    ? undefined
                    : day.future
                      ? `${day.date}：尚未到达`
                      : `${day.date}：${day.count} 次记录`
                }
              />
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
  <div class="activity-summary">
    <p>
      <strong>{stats.activeDays}</strong> 天活跃 ·{" "}
      <strong>{stats.total.toLocaleString("zh-CN")}</strong> 次记录
    </p>
    <div class="legend" aria-label="颜色越深，活动越多">
      <span>少</span>
      {[0, 1, 2, 3, 4].map((level) => (
        <i class="calendar-day" data-level={level} aria-hidden="true" />
      ))}
      <span>多</span>
    </div>
  </div>
  <p class="activity-note">
    <span>{year} 年</span>
    <span>
      {available ? `同步于 ${syncedDate}` : `GitHub ${year} 年数据待同步`}
    </span>
  </p>
</div>

<style>
  .activity-calendar {
    width: 100%;
    color: hsl(var(--muted-foreground));
    font-size: 11px;
  }
  .record-heading,
  .activity-summary,
  .activity-note {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .record-heading {
    margin-bottom: 20px;
    justify-content: flex-end;
  }
  .github-profile {
    display: inline-flex;
    margin-inline-start: auto;
    gap: 6px;
    align-items: center;
    text-decoration: none;
    min-height: 32px;
  }
  .github-profile:hover {
    color: hsl(var(--primary));
  }
  .calendar-wrapper {
    max-width: 100%;
    overflow-x: auto;
    padding-bottom: 8px;
    scrollbar-width: thin;
  }
  .calendar-wrapper:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 4px;
    border-radius: 3px;
  }
  .calendar-main {
    min-width: 640px;
  }
  .month-labels,
  .calendar-grid {
    display: grid;
    grid-template-columns: repeat(var(--week-count), minmax(0, 1fr));
    column-gap: 3px;
  }
  .month-labels {
    margin-bottom: 10px;
    font-size: 10px;
  }
  .week-column {
    display: grid;
    grid-template-rows: repeat(7, 1fr);
    gap: 3px;
  }
  .calendar-day {
    display: block;
    aspect-ratio: 1;
    border-radius: 3px;
    background: hsl(var(--primary) / 0.05);
    border: 1px solid hsl(var(--border));
  }
  .calendar-day.outside {
    visibility: hidden;
  }
  .calendar-day.future {
    opacity: 0.4;
  }
  .calendar-day:not(.outside):not(.future):hover {
    outline: 1px solid hsl(var(--primary));
    outline-offset: 1px;
  }
  .activity-calendar .calendar-day[data-level="1"] {
    background: hsl(var(--primary) / 0.22);
  }
  .activity-calendar .calendar-day[data-level="2"] {
    background: hsl(var(--primary) / 0.42);
  }
  .activity-calendar .calendar-day[data-level="3"] {
    background: hsl(var(--primary) / 0.65);
  }
  .activity-calendar .calendar-day[data-level="4"] {
    background: hsl(var(--primary));
  }
  .activity-summary {
    border-top: 1px solid hsl(var(--border));
    padding-top: 14px;
    margin-top: 8px;
    line-height: 1.8;
  }
  .activity-summary p {
    margin: 0;
  }
  .activity-summary strong {
    color: hsl(var(--primary));
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .legend {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 10px;
  }
  .legend .calendar-day {
    width: 9px;
  }
  .legend span:first-child {
    margin-right: 4px;
  }
  .legend span:last-child {
    margin-left: 4px;
  }
  .activity-note {
    margin: 10px 0 0;
    font-size: 10px;
    line-height: 1.6;
  }
  @media (max-width: 539px) {
    .github-profile {
      font-size: 10px;
    }
    .activity-summary {
      align-items: flex-start;
    }
  }
</style>
