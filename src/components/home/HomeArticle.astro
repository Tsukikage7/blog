---
import type { ImageMetadata } from "astro";
import { formatDate } from "@lib/formatDate";
import SmartImage from "@components/common/SmartImage.astro";

interface Props {
  entry: {
    title: string;
    href: string;
    description?: string | null;
    created?: Date;
    label: string;
    cta?: string;
    image?: ImageMetadata | string | null;
    imageAlt?: string | null;
  };
  featured?: boolean;
}
const { entry, featured = false } = Astro.props;
---

<article class:list={["home-article", { featured }]}>
  <a href={entry.href} class="article-link" aria-label={entry.title}>
    <div class="article-image">
      {entry.image ? (
        <SmartImage
          src={entry.image}
          alt={entry.imageAlt || ""}
          width={featured ? 720 : 240}
          class="cover"
          loading={featured ? "eager" : "lazy"}
          fetchpriority={featured ? "high" : "auto"}
          quality={80}
        />
      ) : (
        <div class="cover-placeholder" aria-hidden="true">
          <span>{entry.label}</span>
          <span>{entry.title}</span>
        </div>
      )}
    </div>
    <div class="article-copy">
      <div class="article-meta">
        <span>{entry.label}</span>
        {entry.created && (
          <time datetime={entry.created.toISOString()}>
            {formatDate(entry.created)}
          </time>
        )}
      </div>
      <h3>{entry.title}</h3>
      {entry.description && (
        <p class="article-description">{entry.description}</p>
      )}
      {featured && (
        <span class="article-cta">
          {entry.cta || "阅读全文"} <span aria-hidden="true">↗</span>
        </span>
      )}
    </div>
  </a>
</article>

<style>
  .home-article {
    min-width: 0;
    border-bottom: 1px solid hsl(var(--border) / 0.6);
  }
  .home-article:last-child {
    border-bottom: 0;
  }
  .article-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 116px;
    gap: 20px;
    align-items: center;
    padding-block: 18px;
  }
  .home-article:first-child .article-link {
    padding-top: 0;
  }
  .article-image {
    order: 2;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 6px;
    background: hsl(var(--secondary));
  }
  .article-image :global(.cover) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }
  .article-link:hover :global(.cover) {
    transform: scale(1.035);
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    margin-bottom: 8px;
    font-size: 11px;
    line-height: 1.5;
    color: hsl(var(--muted-foreground));
  }
  .article-meta > span {
    color: hsl(var(--primary));
  }
  .article-meta time {
    font-variant-numeric: tabular-nums;
  }
  h3 {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.55;
    text-wrap: pretty;
    transition: color 0.2s;
  }
  .article-link:hover h3 {
    color: hsl(var(--primary));
  }
  .article-description {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    overflow: hidden;
    margin-top: 7px;
    color: hsl(var(--muted-foreground));
    font-size: 12px;
    line-height: 1.8;
  }
  .featured {
    border: 0;
  }
  .featured .article-link {
    display: block;
    padding: 0;
  }
  .featured .article-image {
    aspect-ratio: 16 / 10;
    border-radius: 8px;
  }
  .featured .article-copy {
    padding-top: 20px;
  }
  .featured .article-meta {
    font-size: 11px;
    margin-bottom: 10px;
  }
  .featured h3 {
    font-size: 25px;
    line-height: 1.45;
    letter-spacing: -0.025em;
  }
  .featured .article-description {
    -webkit-line-clamp: 2;
    font-size: 14px;
    margin-top: 12px;
  }
  .article-cta {
    display: inline-flex;
    gap: 24px;
    align-items: center;
    margin-top: 18px;
    font-size: 12px;
    color: hsl(var(--primary));
  }
  .cover-placeholder {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    height: 100%;
    padding: 12%;
    color: hsl(var(--primary));
    background: hsl(var(--primary) / 0.05);
  }
  .cover-placeholder > span:first-child {
    font-size: 10px;
    letter-spacing: 0.1em;
  }
  .cover-placeholder > span:last-child {
    font-family: "Songti SC", serif;
    font-size: 16px;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }
  .featured .cover-placeholder > span:last-child {
    font-size: 30px;
  }
  .article-link:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 6px;
    border-radius: 6px;
  }
  .article-link:active {
    transform: translateY(1px);
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .article-link {
      grid-template-columns: minmax(0, 1fr) 85px;
      gap: 14px;
    }
    h3 {
      font-size: 14px;
    }
    .featured h3 {
      font-size: 22px;
    }
  }
  @media (max-width: 767px) {
    .article-link {
      grid-template-columns: minmax(0, 1fr) 96px;
      gap: 16px;
      padding-block: 20px;
    }
    .featured h3 {
      font-size: 23px;
    }
    .featured .article-copy {
      padding-top: 16px;
    }
    .featured .article-description {
      font-size: 13px;
    }
    .article-description {
      -webkit-line-clamp: 2;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .article-image :global(.cover),
    h3 {
      transition: none;
    }
    .article-link:hover :global(.cover),
    .article-link:active {
      transform: none;
    }
  }
</style>
