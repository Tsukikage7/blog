---
import { SITE_INFO } from "@lib/config";
---

<div class="author-profile">
  <div class="relative">
    <div class="absolute inset-0 bg-linear-to-br from-primary/5 via-primary/10 to-primary/5 rounded-lg blur-xl"></div>

    <div class="relative">
      <div class="flex flex-col items-center space-y-4">
        <div class="relative group">
          <div class="absolute -inset-2 bg-linear-to-r from-primary/60 via-primary to-primary/70 rounded-full blur-lg opacity-20 group-hover:opacity-40 transition-all duration-500 animate-pulse"></div>

          <div class="absolute -inset-1 bg-linear-to-r from-primary/60 via-primary to-primary/70 rounded-full opacity-60 group-hover:opacity-80 transition-all duration-300"></div>
          <img
            class="relative w-24 h-24 lg:w-28 lg:h-28 rounded-full border-2 border-border shadow-2xl transform group-hover:scale-105 transition-all duration-300 bg-card"
            src={SITE_INFO.AUTHOR_AVATAR}
            alt="Tsukikage的头像"
            width="112"
            height="112"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>

        <div class="text-center space-y-3">
          <div class="flex flex-col items-center gap-3">
            <h1 class="text-2xl lg:text-3xl font-bold text-foreground">
              Tsukikage
            </h1>
            <div class="flex justify-center gap-2">
              <span class="px-2 py-1 text-xs font-medium bg-secondary text-secondary-foreground rounded-full border border-border">
                读书
              </span>
              <span class="px-2 py-1 text-xs font-medium bg-secondary text-secondary-foreground rounded-full border border-border">
                写字
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  @reference "../../styles/main.css";
  .author-profile {
    min-height: 200px;
    @apply flex items-center justify-center;
  }
</style>
