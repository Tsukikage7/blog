---
interface Props {
  containerType?: "div" | "section" | "nav" | "header" | "footer";

  containerClass?: string;

  wrapperClass?: string;

  textClass?: string;

  animation?: "fadeLeft" | "fadeRight" | "fadeUp" | "fadeDown" | "none";

  heavy?: boolean;

  showContainer?: boolean;

  effectClass?: string;

  tintClass?: string;

  shineClass?: string;
}

const {
  containerType = "div",
  containerClass = "",
  wrapperClass = "dock",
  animation = "none",
  heavy = false,
  showContainer = true,
  textClass = "",
  effectClass = "",
  tintClass = "",
  shineClass = "",
} = Astro.props;

const Container = containerType;

const animationClasses = {
  fadeLeft: "intersect:animate-fadeLeft",
  fadeRight: "intersect:animate-fadeRight",
  fadeUp: "intersect:animate-fadeUp",
  fadeDown: "intersect:animate-fadeDown",
  none: "",
};
const animationClass =
  animation === "none"
    ? ""
    : `${animationClasses[animation]} transition-all duration-300 ease-fast-slow`;

const effectClassStr =
  (heavy ? "liquidGlass-effect-h " : "liquidGlass-effect ") + effectClass;
const tintClassStr =
  (heavy ? "liquidGlass-tint-h " : "liquidGlass-tint ") + tintClass;
---

<Container class={`liquid-glass-container ${containerClass}`}>
  <div
    class={`liquidGlass-wrapper rounded-lg border border-border/50 bg-card/35 text-card-foreground ${wrapperClass}`}
  >
    <div class={`liquidGlass-text ${textClass} ${animationClass}`}>
      <slot />
    </div>
  </div>
</Container>
