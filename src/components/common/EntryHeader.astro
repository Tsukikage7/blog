---
import { Image } from "astro:assets";
import {
  HiOutlineCalendarDays,
  HiOutlineClock,
  HiOutlineFolder,
  HiOutlineUserCircle,
} from "react-icons/hi2";
import type { GenericEntry, EntryReference, ImageData } from "@/types";
import { formatDate } from "@lib/formatDate";
import readingTime from "@lib/readingTime";
import { slugify } from "@lib/textConverter";
import ServerViewCount from "@components/blog/ServerViewCount.astro";

interface EntryData {
  title: string;
  image?: string | ImageData;
  imageAlt?: string;
  author?: EntryReference;
  created?: Date | string;
  updated?: Date | string;
  categories?: string[];
  tags?: string[];
  complexity?: number;
}

interface Props {
  entry: GenericEntry;
  showInfo?: boolean;
  showImage?: boolean;
  showAuthor?: boolean;
  showDate?: boolean;
  showPubDate?: boolean;
  showModDate?: boolean;
  showReadingTime?: boolean;
  showCategories?: boolean;
  showTags?: boolean;
  showViewCount?: boolean;
}

const {
  entry,
  showInfo = true,
  showImage = true,
  showAuthor = false,
  showDate = true,
  showPubDate = false,
  showModDate = false,
  showReadingTime = false,
  showCategories = false,
  showTags = false,
  showViewCount = false,
}: Props = Astro.props;

const {
  title,
  author,
  categories,
  tags,
  image,
  imageAlt,
  created,
  updated,
  complexity,
} = entry.data as EntryData;
const publishedTime = created ? new Date(created).toISOString() : undefined;
---

{showInfo && (
  <header class="entry-header mb-7 sm:mb-9">
    <div class="mb-5 sm:mb-7">
      <h1 class="entry-title text-balance text-3xl font-semibold leading-snug tracking-tight text-foreground sm:text-4xl">
        {title}
      </h1>

      <ul class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-muted-foreground">
        {author && showAuthor && (
          <li>
            <a
              href={`/authors/${slugify(author.id)}`}
              class="inline-flex items-center gap-1.5 transition-colors hover:text-primary"
            >
              <HiOutlineUserCircle
                className="size-4 shrink-0"
                aria-hidden="true"
              />
              <span>{author.id}</span>
            </a>
          </li>
        )}
        {created && showDate && (
          <li class="inline-flex items-center gap-1.5" title="创建日期">
            <HiOutlineCalendarDays
              className="size-4 shrink-0"
              aria-hidden="true"
            />
            <time datetime={publishedTime}>{formatDate(created)}</time>
          </li>
        )}
        {created && showPubDate && (
          <li class="inline-flex items-center gap-1.5" title="发布日期">
            <HiOutlineCalendarDays
              className="size-4 shrink-0"
              aria-hidden="true"
            />
            <time datetime={publishedTime}>发布于 {formatDate(created)}</time>
          </li>
        )}
        {updated && showModDate && (
          <li class="inline-flex items-center gap-1.5" title="更新日期">
            <HiOutlineCalendarDays
              className="size-4 shrink-0"
              aria-hidden="true"
            />
            <time datetime={new Date(updated).toISOString()}>
              更新于 {formatDate(updated)}
            </time>
          </li>
        )}
        {showReadingTime && (
          <li class="inline-flex items-center gap-1.5" title="预计阅读时间">
            <HiOutlineClock className="size-4 shrink-0" aria-hidden="true" />
            <span>{readingTime(entry.body || "", complexity || 1)}</span>
          </li>
        )}
        {showViewCount && (
          <li class="inline-flex items-center gap-1.5" title="浏览次数">
            <ServerViewCount slug={entry.id} />
          </li>
        )}
      </ul>

      {(showCategories && (categories?.length ?? 0) > 0) ||
      (showTags && (tags?.length ?? 0) > 0) ? (
        <ul class="mt-4 flex flex-wrap gap-2 text-xs">
          {showCategories &&
            categories?.map((category) => (
              <li>
                <a
                  href={`/blog/categories/${slugify(category)}/`}
                  class="inline-flex items-center gap-1 py-1 pr-3 text-primary transition-colors hover:underline"
                >
                  <HiOutlineFolder
                    className="size-4 shrink-0"
                    aria-hidden="true"
                  />
                  {category}
                </a>
              </li>
            ))}
          {showTags &&
            tags?.map((tag) => (
              <li>
                <a
                  href={`/blog/tags/${slugify(tag)}/`}
                  class="inline-flex items-center gap-1 py-1 pr-3 text-primary transition-colors hover:underline"
                >
                  <span aria-hidden="true">#</span>
                  {tag}
                </a>
              </li>
            ))}
        </ul>
      ) : null}
    </div>

    {image && showImage && (
      <figure class="overflow-hidden rounded-lg bg-muted/40">
        {typeof image === "string" ? (
          <img
            class="mx-auto h-auto max-h-[min(65vh,42rem)] w-full object-contain"
            src={image}
            alt={imageAlt || title}
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <Image
            class="mx-auto h-auto max-h-[min(65vh,42rem)] w-full object-contain"
            src={image}
            alt={imageAlt || title}
            loading="eager"
            fetchpriority="high"
          />
        )}
      </figure>
    )}
  </header>
)}

<style>
  .entry-title {
    font-family: var(--font-editorial);
    line-height: 1.45;
  }
</style>
