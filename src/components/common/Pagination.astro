---
import { FaArrowLeft, FaArrowRight } from "react-icons/fa";

type Props = {
  collection?: string;
  pageIndex?: number;
  pageCount?: number;
  pageIDs?: string[];
  basePath?: string;
};

const {
  collection,
  pageIndex = 1,
  pageCount = 1,
  pageIDs,
  basePath,
} = Astro.props;

let pageList: number[] = [];
for (let i = 1; i <= pageCount; i++) {
  pageList.push(i);
}

const getPageLink = (page: number): string => {
  const path = (basePath ?? `/${collection}`).replace(/\/$/, "");
  if (basePath) {
    return page === 1 ? `${path}/` : `${path}/${page}/`;
  } else if (pageIDs && pageIDs.length > 0) {
    const pageID = pageIDs[page - 1];
    return pageID ? `${path}/${pageID}/` : `${path}/`;
  } else {
    return page === 1 ? `${path}/` : `${path}/${page}/`;
  }
};

let prevPage: string | null;
let nextPage: string | null;

if (pageIndex > 1) {
  prevPage = getPageLink(pageIndex - 1);
} else {
  prevPage = null;
}

if (pageIndex < pageCount) {
  nextPage = getPageLink(pageIndex + 1);
} else {
  nextPage = null;
}
---

{pageCount > 1 && (
  <nav
    aria-label="文章分页"
    class="flex items-center justify-center border-t border-border/60 pt-6 pb-2"
  >
    <div class="flex flex-wrap items-center justify-center gap-1 sm:gap-2">
      {}
      {prevPage ? (
        <a
          href={prevPage}
          class="rounded px-3 py-2.5 sm:px-3 sm:py-2 min-w-[44px] min-h-[44px] flex items-center justify-center text-foreground"
          aria-label="上一页"
        >
          <FaArrowLeft className="inline-block" />
        </a>
      ) : (
        <span
          class="rounded px-3 py-2.5 sm:px-3 sm:py-2 min-w-[44px] min-h-[44px] flex items-center justify-center text-muted-foreground"
          aria-label="上一页"
        >
          <FaArrowLeft className="inline-block" />
        </span>
      )}
      {}
      {pageIDs ? (
        <div
          aria-current="page"
          class="rounded px-3 py-2.5 sm:px-4 sm:py-2 min-w-[44px] min-h-[44px] flex items-center justify-center text-foreground"
        >
          {pageIndex + 1}
        </div>
      ) : (
        pageList.map((pagination) =>
          pagination === pageIndex ? (
            <span
              aria-current="page"
              class="rounded px-3 py-2.5 sm:px-4 sm:py-2 min-w-[44px] min-h-[44px] flex items-center justify-center font-semibold bg-primary text-primary-foreground"
            >
              {pagination}
            </span>
          ) : (
            <a
              href={getPageLink(pagination)}
              class="rounded px-3 py-2.5 sm:px-4 sm:py-2 min-w-[44px] min-h-[44px] flex items-center justify-center font-semibold text-foreground"
            >
              {pagination}
            </a>
          ),
        )
      )}

      {}
      {nextPage ? (
        <a
          href={nextPage}
          class="rounded px-3 py-2.5 sm:px-3 sm:py-2 min-w-[44px] min-h-[44px] flex items-center justify-center text-foreground"
          aria-label="下一页"
        >
          <FaArrowRight className="inline-block" />
        </a>
      ) : (
        <span
          class="rounded px-3 py-2.5 sm:px-3 sm:py-2 min-w-[44px] min-h-[44px] flex items-center justify-center text-muted-foreground"
          aria-label="下一页"
        >
          <FaArrowRight className="inline-block" />
        </span>
      )}
    </div>
  </nav>
)}
