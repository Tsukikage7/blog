---
import { breadcrumbs } from "@lib/breadcrumbs";
const { className, title }: { className?: string; title?: string } =
  Astro.props;
const parts = breadcrumbs(Astro.url.pathname, title);
---

<nav aria-label="面包屑导航" class={className}>
  <ol class="inline-flex max-w-full flex-wrap" role="list">
    {parts.map(({ label, ...attrs }, index) => (
      <li class={`mx-1 capitalize ${index === parts.length - 1 ? "min-w-0 break-words" : "shrink-0"}`} role="listitem">
        {index > 0 && <span class="inline-block mr-1 shrink-0">/</span>}
        {index !== parts.length - 1 ? (
          <a class="shrink-0 text-foreground" {...attrs}>
            {label}
          </a>
        ) : (
          <span
            class="break-words text-muted-foreground"
            aria-current="page"
          >
            {label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
