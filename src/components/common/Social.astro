---
import type { SocialLinks } from "@/types";
import { FaGithub } from "react-icons/fa";

interface Props {
  links?: SocialLinks;
}

const { links } = Astro.props;
---

{links && (
  <ul class="py-2 flex items-center">
    {links.github && (
      <li>
        <a
          href={links.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          title="GitHub"
          class="flex h-11 w-11 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-muted hover:text-primary"
        >
          <FaGithub className="h-5 w-5" aria-hidden="true" />
        </a>
      </li>
    )}
  </ul>
)}
