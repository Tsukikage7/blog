---
import "../../styles/components/toast.css";
import {
  TOAST_POSITION_CLASSES,
  TOAST_TYPE_CONFIG,
  toastContentClasses,
} from "@lib/toastConfig";

export interface Props {
  title?: string;
  content: string;
  type?: 'success' | 'info' | 'warning' | 'error';
  position?: 'top-right' | 'top-left' | 'bottom-right' | 'bottom-left' | 'top-center' | 'bottom-center';
  duration?: number; 
  showIcon?: boolean;
  closable?: boolean;
}

const {
  title,
  content,
  type = 'info',
  position = 'top-right',
  duration = 3000,
  showIcon = true,
  closable = true
} = Astro.props;

const config = TOAST_TYPE_CONFIG[type];
const positionClasses = TOAST_POSITION_CLASSES;

---

<div 
  class={`toast-container toast-container--mobile-wide fixed z-50 ${positionClasses[position]} pointer-events-none`}
  data-duration={duration}
  data-position={position}
>
  <div class={toastContentClasses(config)}>
    
    <div class="absolute inset-0 rounded-2xl bg-linear-to-r from-foreground/5 to-transparent opacity-50"></div>
    
    
    {closable && (
      <button
        type="button"
        aria-label="关闭通知"
        title="关闭通知"
        class="absolute top-2 right-2 w-6 h-6 rounded-full bg-card/60 hover:bg-muted transition-colors duration-200 flex items-center justify-center text-muted-foreground hover:text-foreground"
        onclick="this.closest('.toast-container').remove()"
      >
        <span class="text-xs">×</span>
      </button>
    )}
    
    
    <div class="flex items-start gap-3 relative z-10">
      
      {showIcon && (
        <div class={`
          shrink-0 w-8 h-8 rounded-full
          bg-linear-to-br ${config.bgColor}
          border ${config.borderColor}
          flex items-center justify-center
          text-lg font-bold ${config.textColor}
          shadow-lg
        `}>
          {config.icon}
        </div>
      )}
      
      
      <div class="flex-1 min-w-0">
        {title && (
          <h4 class={`font-semibold text-sm ${config.textColor} mb-1 leading-tight`}>
            {title}
          </h4>
        )}
        <p class="text-foreground text-sm leading-relaxed">
          {content}
        </p>
      </div>
    </div>
    
    
    {duration > 0 && (
      <div class="absolute bottom-0 left-0 right-0 h-1 bg-foreground/10 rounded-b-2xl overflow-hidden">
        <div class={`h-full bg-linear-to-r ${config.bgColor} toast-progress`} style={`animation-duration: ${duration}ms`}></div>
      </div>
    )}
  </div>
</div>


<script>
  
  document.addEventListener('DOMContentLoaded', function() {
    const toasts = document.querySelectorAll('.toast-container');
    
    toasts.forEach(toast => {
      const toastElement = toast as HTMLElement;
      const duration = parseInt(toastElement.dataset.duration || '0');
      
      if (duration > 0) {
        setTimeout(() => {
          
          const content = toast.querySelector('.toast-content') as HTMLElement;
          if (content) {
            content.style.transform = 'translateY(-20px) scale(0.95)';
            content.style.opacity = '0';
            content.style.transition = 'all 0.3s ease-in';
            
            setTimeout(() => {
              toast.remove();
            }, 300);
          }
        }, duration);
      }
    });
  });
</script>
