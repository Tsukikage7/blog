---
import ReadingTabs from "@components/series/ReadingTabs.astro";
import BaseLayout from "@components/base/BaseLayout.astro";
import Pagination from "@components/common/Pagination.astro";
import PageHeader from "@components/common/PageHeader.astro";
import BlogListCard from "@components/blog/BlogListCard.astro";
import { slugify } from "@lib/textConverter";
import type { BlogEntry } from "@/types";

interface CategoryWithCount {
  name: string;
  slug: string;
  count: number;
}

interface Props {
  entryIndex: BlogEntry;
  entries: BlogEntry[];
  tags: string[];
  categories: string[] | CategoryWithCount[];

  pageIndex: number;
  pageCount: number;
  allBlogCount?: number;
  basePath?: string;
}

const {
  entryIndex,
  entries,
  tags,
  categories,

  pageIndex,
  pageCount,
  allBlogCount,
  basePath,
} = Astro.props;

const { title, description } = entryIndex
  ? entryIndex.data
  : {
      title: "博客",
      description: "所有文章",
    };

// 使用内容模型的发布日期。
const getEntryDate = (entry: BlogEntry) => {
  return entry.data.created;
};

// 按年份分组
const entriesByYear = entries.reduce(
  (acc, entry) => {
    const entryDate = getEntryDate(entry);
    const year = entryDate
      ? new Date(entryDate).getFullYear()
      : new Date().getFullYear();
    if (!acc[year]) acc[year] = [];
    acc[year].push(entry);
    return acc;
  },
  {} as Record<number, BlogEntry[]>,
);

const years = Object.keys(entriesByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout
  title={pageIndex > 1 ? `${title} · 第 ${pageIndex} 页` : title}
  description={description}
>
  <div class="site-container">
    <PageHeader
      contained
      title={title}
      description={description || "技术实践、问题复盘，以及一路积累的笔记。"}
      articleCount={allBlogCount}
    />
    <ReadingTabs active="blog" />
    <div class="archive-layout">
      <section aria-label="文章归档" class="archive-main">
        {years.map((year) => (
          <section class="year-group" aria-labelledby={`year-${year}`}>
            <div class="year-heading">
              <h2 id={`year-${year}`}>{year}</h2>
              <span>{entriesByYear[year].length} 篇 · 本页</span>
            </div>
            {entriesByYear[year].map((entry) => (
              <BlogListCard entry={entry} />
            ))}
          </section>
        ))}
        {entries.length === 0 && (
          <p class="py-12 text-muted-foreground">这里暂时还没有文章。</p>
        )}
        <Pagination
          collection="blog"
          pageIndex={pageIndex}
          pageCount={pageCount}
          basePath={basePath}
        />
      </section>
      <aside class="archive-aside" aria-label="探索文章">
        <p class="aside-label">按主题阅读</p>
        <h2>找到感兴趣的方向</h2>
        <div class="category-list">
          {categories.map((category) => {
            const cat =
              typeof category === "string"
                ? { name: category, slug: slugify(category), count: undefined }
                : category;
            return (
              <a href={`/blog/categories/${cat.slug}/`}>
                <span>{cat.name}</span>
                <span>{cat.count}</span>
              </a>
            );
          })}
        </div>
        <a class="archive-more" href="/blog/tags/">
          浏览全部标签 <span aria-hidden="true">↗</span>
        </a>
        <p class="archive-note">
          把遇到的问题写下来，
          <br />
          也把走过的路留给后来的人。
        </p>
      </aside>
    </div>
  </div>
</BaseLayout>
<style>
  .archive-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 230px;
    gap: 64px;
    border-top: 1px solid hsl(var(--border));
    padding-top: 30px;
  }
  .archive-main {
    min-width: 0;
  }
  .year-group {
    margin-bottom: 36px;
  }
  .year-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 10px;
  }
  .year-heading h2 {
    font-family: var(--font-editorial);
    font-size: 28px;
    font-weight: 500;
  }
  .year-heading > span {
    font-size: 11px;
    color: hsl(var(--muted-foreground));
  }
  .archive-aside {
    position: sticky;
    top: 100px;
    align-self: start;
    padding-left: 26px;
    border-left: 1px solid hsl(var(--border));
  }
  .aside-label {
    font-size: 11px;
    color: hsl(var(--primary));
    margin-bottom: 12px;
  }
  .archive-aside h2 {
    font-size: 16px;
    margin-bottom: 20px;
  }
  .category-list a {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    font-size: 13px;
    color: hsl(var(--muted-foreground));
  }
  .category-list a:hover {
    color: hsl(var(--primary));
  }
  .category-list a > span:last-child {
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
  .archive-more {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid hsl(var(--border));
    padding-top: 18px;
    margin-top: 14px;
    font-size: 12px;
    color: hsl(var(--primary));
  }
  .archive-note {
    margin-top: 30px;
    font-family: var(--font-editorial);
    font-size: 14px;
    line-height: 2;
    color: hsl(var(--muted-foreground));
  }
  @media (max-width: 1023px) {
    .archive-layout {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .archive-aside {
      position: static;
      padding: 24px 0 0;
      border-left: 0;
      border-top: 1px solid hsl(var(--border));
    }
    .category-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 32px;
    }
    .archive-note {
      display: none;
    }
  }
</style>
