---
import BaseLayout from "@components/base/BaseLayout.astro";
import { slugify } from "@lib/textConverter";
import PageHeader from "@components/common/PageHeader.astro";

interface Props {
  collection?: "blog" | "writings" | "notes";
  taxonomy: string;
  taxonomyTitle: string;
  taxa: string[];
  allTaxa: string[];
}

const {
  collection = "blog",
  taxonomy,
  taxonomyTitle,
  taxa,
  allTaxa,
}: Props = Astro.props;
---

<BaseLayout
  title={taxonomyTitle}
  description={`${taxonomyTitle}索引，共 ${taxa.length} 项，按主题浏览文章。`}
  noindex={taxa.length === 0}
>
  <div>
    <PageHeader
      title={taxonomyTitle}
      description={
        taxonomy === "categories"
          ? "按方向整理的笔记，找到你想深入的话题。"
          : "从一个关键词出发，发现相关的文章与思考。"
      }
      articleCount={taxa.length}
      countLabel={taxonomy === "categories" ? "个分类" : "个标签"}
    />
    <section class="site-container pb-12">
      {taxa.length > 0 && (
        <div class="grid grid-cols-1 gap-x-12 sm:grid-cols-2 xl:grid-cols-3 border-t border-border">
          {taxa.map((taxon: string) => {
            const count = allTaxa.filter((c) => c === taxon).length;
            return (
              <a
                href={`/${collection}/${taxonomy}/${slugify(taxon)}/`}
                class="group flex min-w-0 items-center justify-between gap-4 border-b border-border/60 py-5 text-muted-foreground transition-colors hover:text-foreground"
              >
                <span class="flex min-w-0 items-center gap-2">
                  <span class="h-1 w-1 shrink-0 rounded-full bg-border transition-colors group-hover:bg-primary"></span>
                  <span class="truncate text-sm md:text-base">{taxon}</span>
                </span>
                <span class="shrink-0 px-2 py-0.5 text-xs text-muted-foreground tabular-nums transition-colors group-hover:bg-accent">
                  {count}
                </span>
              </a>
            );
          })}
        </div>
      )}
      {taxa.length === 0 && (
        <div class="py-12 text-center">
          <p class="text-lg text-muted-foreground">暂无{taxonomyTitle}</p>
        </div>
      )}
    </section>
  </div>
</BaseLayout>
