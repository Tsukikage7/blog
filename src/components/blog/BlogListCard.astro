---
import type { BlogEntry } from "@/types";
import { plainify, slugify } from "@lib/textConverter";
import { formatDate } from "@lib/formatDate";
import readingTime from "@lib/readingTime";
import PlaceholderImage from "@components/blog/PlaceholderImage.astro";
import SmartImage from "@components/common/SmartImage.astro";

interface Props {
  entry: BlogEntry;
}

const { entry }: Props = Astro.props;
const { title, description, created, date, categories, tags, image, imageAlt } =
  entry.data;
const publishedAt = created || date;
const summary = description?.trim() || plainify(entry.body || "").slice(0, 180);
const hasImage = Boolean(image);
---

<article class="blog-list-card grid items-center gap-5 border-b border-border/60 py-6 last:border-b-0 sm:gap-8">
  <a
    href={`/blog/${entry.id}/`}
    class="blog-list-cover relative block overflow-hidden rounded-md bg-muted"
    aria-label={`阅读：${title}`}
  >
    {hasImage ? (
      <SmartImage
        src={image!}
        alt={imageAlt || title}
        class="block h-auto w-full"
        loading="lazy"
        quality={60}
      />
    ) : (
      <PlaceholderImage title={title} className="aspect-video w-full" />
    )}
  </a>

  <div class="min-w-0">
    <div class="mb-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
      {publishedAt && (
        <time
          datetime={new Date(publishedAt).toISOString()}
          class="tabular-nums"
        >
          {formatDate(publishedAt)}
        </time>
      )}
      <span class="hidden items-center gap-1 sm:inline-flex">
        <span aria-hidden="true">·</span>
        {readingTime(entry.body || "", 1)}
      </span>
    </div>

    <h2 class="text-base font-semibold leading-relaxed tracking-tight text-foreground sm:text-xl">
      <a
        href={`/blog/${entry.id}/`}
        class="decoration-primary/50 underline-offset-4 transition-colors hover:text-primary hover:underline"
      >
        {title}
      </a>
    </h2>

    {summary && (
      <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-muted-foreground">
        {summary}
      </p>
    )}

    {((categories?.length ?? 0) > 0 || (tags?.length ?? 0) > 0) && (
      <div class="mt-2.5 flex flex-wrap gap-x-3 gap-y-1 text-xs text-muted-foreground">
        {categories?.slice(0, 2).map((category) => (
          <a
            href={`/blog/categories/${slugify(category)}/`}
            class="transition-colors hover:text-primary"
          >
            {category}
          </a>
        ))}
        {tags?.slice(0, 2).map((tag) => (
          <a
            href={`/blog/tags/${slugify(tag)}/`}
            class="transition-colors hover:text-primary"
          >
            <span aria-hidden="true">#</span>
            {tag}
          </a>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .blog-list-card {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 540px) {
    .blog-list-card {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }

    .blog-list-cover {
      order: 2;
    }
  }
</style>
