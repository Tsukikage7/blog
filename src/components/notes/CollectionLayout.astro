---
import BaseLayout from "@components/base/BaseLayout.astro";
import PageHeader from "@components/common/PageHeader.astro";
import Pagination from "@components/common/Pagination.astro";
import ReadingTabs from "@components/series/ReadingTabs.astro";
import { formatDate } from "@lib/formatDate";
import { slugify, plainify } from "@lib/textConverter";
import type { NotesEntry } from "@/types";
interface Props {
  entryIndex?: NotesEntry;
  entries: NotesEntry[];
  tags: string[];
  pageIndex: number;
  pageCount: number;
  allNotesCount?: number;
  basePath?: string;
}
const {
  entryIndex,
  entries,
  tags,
  pageIndex,
  pageCount,
  allNotesCount,
  basePath,
} = Astro.props;
const title = entryIndex?.data.title || "笔记";
const description =
  entryIndex?.data.description || "随手记下的想法，和留待查阅的片段。";
---

<BaseLayout
  title={pageIndex > 1 ? `${title} · 第 ${pageIndex} 页` : title}
  description={description}
>
  <div class="site-container">
    <PageHeader
      contained
      title={title}
      description={description}
      articleCount={allNotesCount}
    />
    <ReadingTabs active="notes" />
    <div class="notes-layout">
      <section aria-label="笔记列表">
        {entries.map((entry) => (
          <article class="note-row">
            {entry.data.created && (
              <time datetime={entry.data.created.toISOString()}>
                {formatDate(entry.data.created)}
              </time>
            )}
            <h2>
              <a href={`/notes/${entry.id}/`}>{entry.data.title}</a>
            </h2>
            <p>
              {entry.data.description ||
                plainify(entry.body || "").slice(0, 120)}
            </p>
          </article>
        ))}
        {entries.length === 0 && (
          <p class="py-12 text-muted-foreground">这里暂时还没有笔记。</p>
        )}
        <Pagination
          collection="notes"
          pageIndex={pageIndex}
          pageCount={pageCount}
          basePath={basePath}
        />
      </section>
      {tags.length > 0 && (
        <aside aria-label="笔记标签">
          <p class="aside-label">按标签查找</p>
          <div class="note-tags">
            {tags.map((tag) => (
              <a href={`/notes/tags/${slugify(tag)}/`}>{tag}</a>
            ))}
          </div>
        </aside>
      )}
    </div>
  </div>
</BaseLayout>
<style>
  .notes-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 64px;
  }
  .note-row {
    border-bottom: 1px solid hsl(var(--border) / 0.6);
    padding: 24px 0;
  }
  .note-row:first-child {
    padding-top: 4px;
  }
  time,
  .aside-label {
    font-size: 12px;
    color: hsl(var(--muted-foreground));
  }
  h2 {
    font-family: var(--font-editorial);
    font-size: 24px;
    line-height: 1.6;
    margin: 10px 0;
  }
  p {
    color: hsl(var(--muted-foreground));
    font-size: 14px;
    line-height: 1.9;
  }
  a:hover {
    color: hsl(var(--primary));
  }
  a:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 4px;
  }
  .note-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 18px;
    margin-top: 20px;
    font-size: 13px;
  }
  @media (max-width: 767px) {
    .notes-layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    h2 {
      font-size: 21px;
    }
  }
</style>
