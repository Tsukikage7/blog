---
import TaxaLayout from "@components/blog/TaxaLayout.astro";

interface Props {
  taxonomy: string;
  taxa: string[];
  allTaxa: string[];
}

const { taxonomy, taxa, allTaxa } = Astro.props;
---

<TaxaLayout
  collection="notes"
  taxonomy={taxonomy}
  taxonomyTitle="笔记标签"
  taxa={taxa}
  allTaxa={allTaxa}
/>
