---
import ThemeSwitcher from "@components/base/ThemeSwitcher.astro";
import { SITE_INFO, AVATAR_IMAGE } from "@lib/config";
import { Image } from "astro:assets";
import { getEntries } from "@lib/contentParser";
import { canonicalPath } from "@lib/site";

const [notes, writings] = await Promise.all([
  getEntries("notes"),
  getEntries("writings"),
]);

const { pathname } = Astro.url;

const stickyHeader = true;

let siteName = SITE_INFO?.SITE_NAME || "";
let siteLogoUrl = SITE_INFO?.LOGO_IMAGE || "";

const menuItems = [
  {
    id: 1,
    name: "首页",
    url: "/",
  },
  {
    id: 2,
    name: "文章",
    url: "/blog",
  },
  {
    id: 7,
    name: "合集",
    url: "/series",
  },
  {
    id: 3,
    name: "创作",
    url: "/writings",
  },
  {
    id: 4,
    name: "笔记",
    url: "/notes",
  },
  {
    id: 5,
    name: "音乐",
    url: "/music",
  },
  {
    id: 6,
    name: "关于",
    url: "/about",
  },
];

const menu = menuItems
  .filter((item) => item.url !== "/notes" || notes.length > 0)
  .filter((item) => item.url !== "/writings" || writings.length > 0)
  .map((item) => ({ ...item, url: canonicalPath(item.url) }));

// 以最长路径匹配当前入口，文章下的目录页也归属“文章”。
const activeItem = menu
  .filter(
    (item) =>
      pathname === item.url ||
      (item.url !== "/" && pathname.startsWith(item.url)),
  )
  .sort((a, b) => b.url.length - a.url.length)[0];
---

<header
  class={`w-full py-3 z-30 bg-background/80 backdrop-blur-sm border-b border-border/30 ${stickyHeader && "sticky top-0"}`}
>
  <div class="site-container">
    <nav class="site-nav" aria-label="全站导航">
      <!-- Logo + Site Name -->
      <div class="shrink-0">
        <a href="/" class="flex items-center gap-2">
          {siteLogoUrl && (
            <Image
              src={AVATAR_IMAGE}
              alt={siteName}
              class="w-8 h-8 rounded-full"
              width={32}
              height={32}
              format="webp"
              loading="eager"
            />
          )}
          {siteName && (
            <span class="site-name text-lg font-semibold text-foreground">
              {siteName}
            </span>
          )}
        </a>
      </div>

      <!-- Mobile menu toggle -->
      <input
        id="nav-toggle"
        type="checkbox"
        aria-label="切换导航菜单"
        aria-controls="nav-menu"
        class="peer sr-only lg:hidden"
      />
      <label
        for="nav-toggle"
        aria-label="切换导航菜单"
        class="nav-toggle peer-focus-visible:ring-2 peer-focus-visible:ring-ring peer-focus-visible:ring-offset-2"
      >
        <svg
          id="show-button"
          class="h-5 w-5 block"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            d="M3 5h14M3 10h14M3 15h14"
            stroke-width="1.7"
            stroke-linecap="round"
          ></path>
        </svg>
        <svg
          id="hide-button"
          class="h-5 w-5 hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            d="m6 6 12 12M18 6 6 18"
            stroke-width="1.7"
            stroke-linecap="round"
          ></path>
        </svg>
        <span class="nav-toggle-label">导航</span>
      </label>

      <!-- 桌面使用文字导航，窄屏展开为双列菜单。 -->
      <ul id="nav-menu" class="site-menu">
        {menu.map((item) => {
          const isActive = activeItem?.id === item.id;
          return (
            <li>
              <a
                href={item.url}
                aria-current={isActive ? "page" : undefined}
                class={`nav-link ${
                  isActive
                    ? "text-primary"
                    : "text-muted-foreground hover:text-foreground"
                }`}
              >
                <span>{item.name}</span>
              </a>
            </li>
          );
        })}
      </ul>

      <!-- Right icons -->
      <div class="nav-actions shrink-0 flex items-center gap-1">
        <a
          class="text-muted-foreground hover:text-primary transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center rounded-md"
          href="/search/"
          aria-label="搜索"
          title="搜索"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7" stroke-width="1.7" />
            <path
              d="m16 16 4.5 4.5"
              stroke-width="1.7"
              stroke-linecap="round"
            />
          </svg>
        </a>

        <button
          id="random-article-btn"
          class="text-muted-foreground hover:text-primary transition-colors group min-w-[44px] min-h-[44px] flex items-center justify-center rounded-md"
          aria-label="随机打开一篇文章"
          title="随机文章"
        >
          <svg
            class="w-5 h-5 transition-transform duration-300 group-hover:rotate-180"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.7"
              d="M20 4v3.5a.3.3 0 0 1-.3.3H16a.3.3 0 0 1-.212-.512l1.147-1.146A8 8 0 0 0 4.34 8.54a.6.6 0 0 1-1.159-.308A10 10 0 0 1 18.207 4.54l1.147-1.146A.3.3 0 0 1 20 4zm-16 16v-3.5a.3.3 0 0 1 .3-.3H8a.3.3 0 0 1 .212.512L7.207 18A8 8 0 0 0 19.66 15.46a.6.6 0 0 1 1.159.308A10 10 0 0 1 5.793 19.46l-1.147 1.146A.3.3 0 0 1 4 20z"
            />
          </svg>
        </button>

        <ThemeSwitcher />
      </div>
    </nav>
  </div>

  <style>
    :global(:root) {
      --site-header-offset: 100px;
    }
    .site-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    .nav-actions {
      margin-left: auto;
    }
    .nav-toggle {
      display: inline-flex;
      order: 3;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 44px;
      min-width: 44px;
      color: hsl(var(--muted-foreground));
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      border-radius: 4px;
    }
    .site-menu {
      display: none;
    }
    .nav-link {
      position: relative;
      display: flex;
      align-items: center;
      min-height: 44px;
      padding: 10px 0;
      font-size: 14px;
      font-weight: 500;
      letter-spacing: 0.03em;
      white-space: nowrap;
      transition: color 0.18s;
    }
    .nav-link::after {
      content: "";
      position: absolute;
      right: 0;
      bottom: 3px;
      left: 0;
      height: 2px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.18s;
    }
    .nav-link:hover {
      color: hsl(var(--primary));
    }
    .nav-link[aria-current="page"]::after {
      transform: scaleX(1);
    }
    .nav-link[aria-current="page"] {
      color: hsl(var(--primary));
    }
    .nav-link:focus-visible {
      outline: 2px solid hsl(var(--ring));
      outline-offset: 3px;
    }
    @media (min-width: 1024px) {
      .nav-toggle {
        display: none;
      }
      .site-menu {
        display: flex;
        flex: 1;
        align-items: center;
        justify-content: center;
        gap: 24px;
      }
      .site-menu > li {
        flex-shrink: 0;
      }
      .nav-actions {
        margin-left: 0;
      }
    }
    @media (min-width: 1280px) {
      .site-menu {
        gap: 30px;
      }
    }
    @media (max-width: 1023px) {
      .site-menu {
        position: absolute;
        top: 100%;
        left: max(16px, calc((100% - 1216px) / 2));
        right: max(16px, calc((100% - 1216px) / 2));
        margin-top: 8px;
        padding: 12px 24px;
        max-height: calc(100dvh - 90px);
        overflow-y: auto;
        gap: 0 28px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        border: 1px solid hsl(var(--border));
        border-radius: 8px;
        background: hsl(var(--popover));
        box-shadow: 0 12px 32px -16px hsl(var(--foreground) / 0.16);
      }
      .site-menu > li:nth-last-child(n + 3) {
        border-bottom: 1px solid hsl(var(--border) / 0.6);
      }
      #nav-toggle:checked ~ .site-menu {
        display: grid;
      }
      #nav-toggle:checked + label #show-button {
        display: none;
      }
      #nav-toggle:checked + label #hide-button {
        display: block;
      }
      .nav-link {
        min-height: 52px;
        padding: 14px 12px;
      }
      .nav-link::after {
        display: none;
      }
      .nav-link[aria-current="page"]::before {
        content: "";
        position: absolute;
        left: 0;
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: currentColor;
      }
    }
    @media (max-width: 539px) {
      .site-nav {
        gap: 8px;
      }
      .site-name {
        font-size: 16px;
      }
      .nav-toggle-label {
        display: none;
      }
    }
    @media (max-width: 359px) {
      .site-name {
        display: none;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .nav-link,
      .nav-link::after {
        transition: none;
      }
    }
  </style>

  <script>
    document.addEventListener("astro:page-load", function () {
      const events = new AbortController();
      const { signal } = events;
      document.addEventListener("astro:before-swap", () => events.abort(), {
        once: true,
      });

      const navToggle = document.getElementById(
        "nav-toggle",
      ) as HTMLInputElement | null;
      const closeMenu = () => {
        if (navToggle) navToggle.checked = false;
      };

      // 选中入口、点击外部或按 Escape 都能收起窄屏菜单。
      const menuLinks = document.querySelectorAll("#nav-menu a");
      menuLinks.forEach((link) => {
        link.addEventListener("click", closeMenu, { signal });
      });
      document.addEventListener(
        "keydown",
        (event) => {
          if (event.key === "Escape" && navToggle?.checked) {
            closeMenu();
            navToggle.focus();
          }
        },
        { signal },
      );
      document.addEventListener(
        "pointerdown",
        (event) => {
          if (
            event.target instanceof Node &&
            !navToggle?.closest("nav")?.contains(event.target)
          ) {
            closeMenu();
          }
        },
        { signal },
      );
      window
        .matchMedia("(min-width: 1024px)")
        .addEventListener("change", closeMenu, { signal });

      // 随机文章按钮
      const randomBtn = document.getElementById("random-article-btn");
      if (randomBtn) {
        randomBtn.addEventListener(
          "click",
          async function () {
            const button = this as HTMLButtonElement;
            const originalHTML = button.innerHTML;

            try {
              button.disabled = true;
              button.innerHTML =
                '<svg class="w-5 h-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>';

              const response = await fetch("/api/blog-articles.json");
              if (!response.ok) throw new Error("无法获取文章列表");

              const articles = await response.json();
              if (!articles || articles.length === 0)
                throw new Error("没有找到可用的文章");

              const randomIndex = Math.floor(Math.random() * articles.length);
              window.location.href = `/blog/${articles[randomIndex].slug}/`;
            } catch (error) {
              console.error("获取随机文章失败:", error);
              button.disabled = false;
              button.innerHTML = originalHTML;
              alert("获取随机文章失败，请稍后重试");
            }
          },
          { signal },
        );
      }
    });
  </script>
</header>
