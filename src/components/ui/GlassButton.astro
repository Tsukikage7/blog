---
interface Props {
  variant?:
    | "primary"
    | "secondary"
    | "success"
    | "warning"
    | "danger"
    | "info"
    | "menu";

  size?: "sm" | "md" | "lg" | "menu";

  disabled?: boolean;

  loading?: boolean;

  icon?: string;

  iconPosition?: "left" | "right";

  className?: string;

  id?: string;

  title?: string;

  type?: "button" | "submit" | "reset";

  onClick?: string;

  open?: boolean;
}

const {
  variant = "primary",
  size = "md",
  disabled = false,
  loading = false,
  icon,
  iconPosition = "left",
  className = "",
  id,
  title,
  type = "button",
  onClick,
  open = true,
} = Astro.props;

const variantStyles = {
  primary: {
    base: "hsl(var(--primary) / 0.16)",
    hover: "hsl(var(--primary) / 0.26)",
    border: "hsl(var(--primary) / 0.4)",
    hoverBorder: "hsl(var(--primary) / 0.65)",
    color: "hsl(var(--primary))",
    hoverColor: "hsl(var(--primary))",
    shadow: "hsl(var(--primary) / 0.25)",
    gradient: "hsl(var(--foreground) / 0.12)",
  },
  secondary: {
    base: "hsl(var(--secondary) / 0.55)",
    hover: "hsl(var(--secondary) / 0.8)",
    border: "hsl(var(--border))",
    hoverBorder: "hsl(var(--muted-foreground) / 0.55)",
    color: "hsl(var(--secondary-foreground))",
    hoverColor: "hsl(var(--secondary-foreground))",
    shadow: "hsl(var(--foreground) / 0.16)",
    gradient: "hsl(var(--foreground) / 0.1)",
  },
  success: {
    base: "hsl(var(--success) / 0.16)",
    hover: "hsl(var(--success) / 0.26)",
    border: "hsl(var(--success) / 0.4)",
    hoverBorder: "hsl(var(--success) / 0.65)",
    color: "hsl(var(--success))",
    hoverColor: "hsl(var(--success))",
    shadow: "hsl(var(--success) / 0.25)",
    gradient: "hsl(var(--foreground) / 0.12)",
  },
  warning: {
    base: "hsl(var(--warning) / 0.16)",
    hover: "hsl(var(--warning) / 0.26)",
    border: "hsl(var(--warning) / 0.4)",
    hoverBorder: "hsl(var(--warning) / 0.65)",
    color: "hsl(var(--warning))",
    hoverColor: "hsl(var(--warning))",
    shadow: "hsl(var(--warning) / 0.22)",
    gradient: "hsl(var(--foreground) / 0.12)",
  },
  danger: {
    base: "hsl(var(--destructive) / 0.14)",
    hover: "hsl(var(--destructive) / 0.24)",
    border: "hsl(var(--destructive) / 0.4)",
    hoverBorder: "hsl(var(--destructive) / 0.65)",
    color: "hsl(var(--destructive))",
    hoverColor: "hsl(var(--destructive))",
    shadow: "hsl(var(--destructive) / 0.24)",
    gradient: "hsl(var(--foreground) / 0.12)",
  },
  info: {
    base: "hsl(var(--info) / 0.16)",
    hover: "hsl(var(--info) / 0.26)",
    border: "hsl(var(--info) / 0.4)",
    hoverBorder: "hsl(var(--info) / 0.65)",
    color: "hsl(var(--info))",
    hoverColor: "hsl(var(--info))",
    shadow: "hsl(var(--info) / 0.22)",
    gradient: "hsl(var(--foreground) / 0.12)",
  },
  menu: {
    base: "hsl(var(--secondary) / 0.55)",
    hover: "hsl(var(--secondary) / 0.8)",
    border: "hsl(var(--border))",
    hoverBorder: "hsl(var(--muted-foreground) / 0.55)",
    color: "hsl(var(--secondary-foreground))",
    hoverColor: "hsl(var(--secondary-foreground))",
    shadow: "hsl(var(--foreground) / 0.16)",
    gradient: "hsl(var(--foreground) / 0.1)",
  },
};

const sizeStyles = {
  sm: {
    padding: "0.5rem 0.75rem",
    fontSize: "0.875rem",
    iconSize: "0.875rem",
    gap: "0.375rem",

    borderRadius: "var(--radius-lg)",
  },
  md: {
    padding: "0.75rem 1rem",
    fontSize: "1rem",
    iconSize: "1rem",
    gap: "0.5rem",

    borderRadius: "var(--radius-lg)",
  },
  lg: {
    padding: "1rem 1.25rem",
    fontSize: "1.1rem",
    iconSize: "1.125rem",
    gap: "0.625rem",

    borderRadius: "var(--radius-lg)",
  },
  menu: {
    padding: "0.5rem 1rem",
    iconSize: "1.25rem",
    fontSize: "inherit",
    gap: "inherit",

    borderRadius: "var(--radius-lg)",
  },
};

const currentVariant = variantStyles[variant];
const currentSize = sizeStyles[size];
const buttonStyle = {
  glassButtonDefaultBase: currentVariant.base,
  glassButtonDefaultHover: currentVariant.hover,
  glassButtonDefaultBorder: currentVariant.border,
  glassButtonDefaultHoverBorder: currentVariant.hoverBorder,
  glassButtonDefaultColor: currentVariant.color,
  glassButtonDefaultHoverColor: currentVariant.hoverColor,
  glassButtonDefaultShadow: currentVariant.shadow,
  glassButtonDefaultGradient: currentVariant.gradient,
  sizePadding: currentSize.padding,
  sizeFontSize: currentSize.fontSize,
  sizeIconSize: currentSize.iconSize,
  sizeGap: currentSize.gap,
  sizeBorderRadius: currentSize.borderRadius,
};
---

<button
  style={Object.fromEntries(
    Object.entries(buttonStyle).map(([key, value]) => [`--${key}`, value]),
  )}
  id={id}
  type={type}
  class={
    open
      ? `glass-button glass-button--${variant} glass-button--${size} select-none ${className} `
      : `glass-button--plain select-none ${className}`
  }
  disabled={disabled || loading}
  title={title}
  onclick={onClick}
>
  {loading && (
    <svg class="glass-button__spinner" viewBox="0 0 24 24">
      <circle
        cx="12"
        cy="12"
        r="10"
        stroke="currentColor"
        stroke-width="4"
        fill="none"
        opacity="0.25"
      />
      <path
        fill="currentColor"
        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
        opacity="0.75"
      />
    </svg>
  )}

  {icon && iconPosition === "left" && !loading && (
    <span class="glass-button__icon" set:html={icon} />
  )}

  <span class="glass-button__content">
    <slot />
  </span>

  {icon && iconPosition === "right" && !loading && (
    <span class="glass-button__icon" set:html={icon} />
  )}
</button>

<style>
  .glass-button--plain {
    gap: var(--sizeGap);
    padding: var(--sizePadding);
  }

  .glass-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sizeGap);
    padding: var(--sizePadding);
    background: var(--glass-button-base, var(--glassButtonDefaultBase));
    border: 1px solid
      var(--glass-button-border, var(--glassButtonDefaultBorder));
    border-radius: var(--sizeBorderRadius);
    font-size: var(--sizeFontSize);
    font-weight: 500;
    color: var(--glass-button-color, var(--glassButtonDefaultColor));
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 2.2);
    box-shadow:
      0 4px 6px hsl(var(--foreground) / 0.12),
      inset 1px 1px 2px hsl(var(--foreground) / 0.08);
    user-select: none;
    overflow: hidden;
    text-decoration: none;
    white-space: nowrap;
  }

  .glass-button::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      var(--glass-button-gradient, var(--glassButtonDefaultGradient)),
      transparent
    );
    transition: left 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    pointer-events: none;
    opacity: 0;
  }

  .glass-button:hover {
    background: var(--glass-button-hover, var(--glassButtonDefaultHover));
    border-color: var(
      --glass-button-hover-border,
      var(--glassButtonDefaultHoverBorder)
    );
    color: var(--glass-button-hover-color, var(--glassButtonDefaultHoverColor));
    transform: translateY(-2px) scale(1.01);
    box-shadow:
      0 8px 20px var(--glass-button-shadow, var(--glassButtonDefaultShadow)),
      inset 1px 1px 4px hsl(var(--foreground) / 0.14);
    filter: brightness(1.1) saturate(1.2);
  }

  .glass-button:hover::before {
    left: 100%;
    opacity: 1;
  }

  .glass-button:active {
    transform: translateY(-1px) scale(0.98);
    box-shadow: 0 2px 6px
      var(--glass-button-shadow, var(--glassButtonDefaultShadow));
  }

  .glass-button:disabled {
    cursor: not-allowed;
    opacity: 0.6;
    transform: none;
    pointer-events: none;
  }

  .glass-button:disabled:hover {
    transform: none;
    box-shadow:
      0 4px 6px hsl(var(--foreground) / 0.12),
      inset 1px 1px 2px hsl(var(--foreground) / 0.08);
  }

  .glass-button__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--sizeIconSize);
    height: var(--sizeIconSize);
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 2.2);
  }

  .glass-button__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .glass-button:hover .glass-button__icon {
    transform: scale(1.2) rotate(-5deg);
    filter: drop-shadow(
      0 4px var(--glass-button-shadow, var(--glassButtonDefaultShadow))
    );
  }

  .glass-button__content {
    display: inline-flex;
    align-items: center;
    transition: all 0.3s ease;
  }

  .glass-button__spinner {
    width: var(--sizeIconSize);
    height: var(--sizeIconSize);
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
</style>
