---
import BaseLayout from "@components/base/BaseLayout.astro";
import WritingsListCard from "./WritingsListCard.astro";
import WorkCard from "./WorkCard.astro";
import Pagination from "@components/common/Pagination.astro";
import PageHeader from "@components/common/PageHeader.astro";
import type { GenericEntry } from "@/types";
import type { WritingItem } from "@lib/writings";
interface Props {
  entryIndex?: GenericEntry;
  items: WritingItem[];
  tags?: string[];
  pageIndex: number;
  pageCount: number;
  countText: string;
  basePath?: string;
  currentTag?: string;
}
const {
  entryIndex,
  items,
  tags = [],
  pageIndex,
  pageCount,
  countText,
  basePath,
  currentTag,
} = Astro.props;
const title = currentTag
  ? `创作 · ${currentTag}`
  : entryIndex?.data.title || "创作";
const description = entryIndex?.data.description || "小说、散文与随笔。";
---

<BaseLayout
  title={pageIndex > 1 ? `${title} · 第 ${pageIndex} 页` : title}
  description={description}
>
  <div class="site-container">
    <PageHeader
      contained
      title={title}
      description={description}
      countText={countText}
    />
    {tags.length > 1 && (
      <nav class="writing-filters" aria-label="创作关键词">
        <a href="/writings/" aria-current={!currentTag ? "page" : undefined}>
          全部
        </a>
        {tags.map((tag) => (
          <a
            href={`/writings/tags/${encodeURIComponent(tag)}/`}
            aria-current={currentTag === tag ? "page" : undefined}
          >
            {tag}
          </a>
        ))}
      </nav>
    )}
    <section aria-label="作品列表" class="writing-list">
      {items.map((item) =>
        item.kind === "series" ? (
          <WorkCard series={item.series} />
        ) : (
          <WritingsListCard entry={item.entry} />
        ),
      )}
      {!items.length && (
        <p class="empty-writing">
          这里暂时没有作品，可以先读读 <a href="/blog/">其他文章 →</a>
        </p>
      )}
    </section>
    {pageCount > 1 && (
      <Pagination
        collection="writings"
        pageIndex={pageIndex}
        pageCount={pageCount}
        basePath={basePath}
      />
    )}
  </div>
</BaseLayout>
<style>
  .writing-list {
    border-top: 1px solid hsl(var(--border));
  }
  .writing-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    font-size: 13px;
    padding-bottom: 24px;
    color: hsl(var(--muted-foreground));
  }
  .writing-filters a:hover,
  .writing-filters a[aria-current] {
    color: hsl(var(--primary));
  }
  .writing-filters a:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 4px;
  }
  .empty-writing {
    padding-block: 48px;
    color: hsl(var(--muted-foreground));
    font-size: 14px;
  }
  .empty-writing a {
    color: hsl(var(--primary));
  }
</style>
