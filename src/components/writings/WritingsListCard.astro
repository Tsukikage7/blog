---
import type { WritingsEntry } from "@/types";
import { plainify } from "@lib/textConverter";
import { chapterHref } from "@lib/seriesModel";
import { formatDate } from "@lib/formatDate";
import readingTime from "@lib/readingTime";
interface Props {
  entry: WritingsEntry;
}
const { entry } = Astro.props;
const date = entry.data.updated || entry.data.created;
const description =
  entry.data.description || plainify(entry.body || "").slice(0, 150);
---

<article class="writing-row">
  <p class="writing-meta">
    {entry.data.genre || "文字"} · {readingTime(entry.body || "", 1)}{" "}
    {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
  </p>
  <h2>
    <a href={chapterHref(entry)}>{entry.data.title}</a>
  </h2>
  <p class="writing-description">{description}</p>
  <a class="read-writing" href={chapterHref(entry)}>
    阅读全文 <span aria-hidden="true">→</span>
  </a>
</article>
<style>
  .writing-row {
    padding-block: 32px;
    border-bottom: 1px solid hsl(var(--border));
    max-width: 50rem;
  }
  .writing-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    font-size: 12px;
    color: hsl(var(--muted-foreground));
    font-variant-numeric: tabular-nums;
  }
  h2 {
    font-family: var(--font-editorial);
    font-size: clamp(24px, 3vw, 30px);
    line-height: 1.5;
    margin-block: 14px;
  }
  .writing-description {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    font-size: 14px;
    line-height: 1.9;
    color: hsl(var(--muted-foreground));
  }
  .read-writing {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    min-height: 44px;
    color: hsl(var(--primary));
    font-size: 13px;
    margin-top: 14px;
  }
  a:hover {
    color: hsl(var(--primary));
  }
  a:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 4px;
  }
</style>
