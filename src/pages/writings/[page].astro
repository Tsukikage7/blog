---
import CollectionLayout from "@components/writings/CollectionLayout.astro";
import { getWritingsCatalog } from "@lib/writings";
export async function getStaticPaths() {
  const { items, pageSize } = await getWritingsCatalog();
  return Array.from(
    { length: Math.max(0, Math.ceil(items.length / pageSize) - 1) },
    (_, i) => ({
      params: { page: String(i + 2) },
      props: { pageIndex: i + 2 },
    }),
  );
}
interface Props {
  pageIndex: number;
}
const { pageIndex } = Astro.props;
const { items, tags, index, countText, pageSize } = await getWritingsCatalog();
---

<CollectionLayout
  entryIndex={index}
  items={items.slice((pageIndex - 1) * pageSize, pageIndex * pageSize)}
  tags={tags}
  pageIndex={pageIndex}
  pageCount={Math.ceil(items.length / pageSize)}
  countText={countText}
/>
