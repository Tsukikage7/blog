---
import TaxaLayout from "@components/blog/TaxaLayout.astro";
import { getEntries } from "@lib/contentParser";

const entries = await getEntries("writings");
const allTaxa = entries.flatMap((entry) => entry.data.tags || []);
const taxa = [...new Set(allTaxa)].sort((a, b) => a.localeCompare(b));
---

<TaxaLayout collection="writings" taxonomy="tags" taxonomyTitle="文字标签" taxa={taxa} allTaxa={allTaxa} />
