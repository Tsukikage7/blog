---
import CollectionLayout from "@components/writings/CollectionLayout.astro";
import { getWritingsCatalog } from "@lib/writings";
export async function getStaticPaths() {
  const { tags } = await getWritingsCatalog();
  return tags.map((tag) => ({ params: { tag }, props: { tag } }));
}
interface Props {
  tag: string;
}
const { tag } = Astro.props;
const { items, tags, index, countText } = await getWritingsCatalog(tag);
---

<CollectionLayout
  entryIndex={index}
  items={items}
  tags={tags}
  currentTag={tag}
  pageIndex={1}
  pageCount={1}
  countText={countText}
/>
