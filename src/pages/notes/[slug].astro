---
import { render } from "astro:content";
import BaseLayout from "@components/base/BaseLayout.astro";
import Breadcrumbs from "@components/common/Breadcrumbs.astro";
import EntryHeader from "@components/common/EntryHeader.astro";
import TableOfContents from "@components/common/TableOfContents.astro";
import ArticleSeries from "@components/series/ArticleSeries.astro";
import ChapterPagination from "@components/series/ChapterPagination.astro";
import Comment from "@components/base/Comment.astro";
import { getEntries } from "@lib/contentParser";
import { getSeries } from "@lib/series";
import { slugify } from "@lib/textConverter";
import { SITE_INFO } from "@lib/config";
import type { NotesEntry } from "@/types";
export async function getStaticPaths() {
  return (await getEntries("notes")).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}
interface Props {
  entry: NotesEntry;
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const series = entry.data.series
  ? (await getSeries()).find((item) => item.entry.id === entry.data.series)
  : undefined;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  articleType
  publishedTime={entry.data.created}
  modifiedTime={entry.data.updated}
  author={SITE_INFO.AUTHOR}
  tags={entry.data.tags}
>
  <section class="site-container note-detail">
    <div class="note-main">
      <Breadcrumbs className="mb-7 text-xs" title={entry.data.title} />
      <article>
        {series && (
          <ArticleSeries
            series={series}
            currentId={entry.id}
            currentCollection="notes"
          />
        )}
        <EntryHeader
          entry={entry}
          showImage={false}
          showReadingTime
          showModDate
        />
        {entry.data.tags?.length ? (
          <nav
            aria-label="笔记标签"
            class="mb-7 flex flex-wrap gap-4 text-xs text-primary"
          >
            {entry.data.tags.map((tag) => (
              <a href={`/notes/tags/${slugify(tag)}/`}>{tag}</a>
            ))}
          </nav>
        ) : null}
        <div class="prose prose-site prose-base max-w-none markdown-content border-t border-border/60 pt-7">
          <Content />
        </div>
        {series && (
          <ChapterPagination
            series={series}
            currentId={entry.id}
            currentCollection="notes"
          />
        )}
        <a class="back-note" href="/notes/">
          ← 返回笔记
        </a>
      </article>
      <Comment />
    </div>
    <aside class="note-aside">
      {series && (
        <ArticleSeries
          series={series}
          currentId={entry.id}
          currentCollection="notes"
          sidebar
        />
      )}
      <TableOfContents headings={headings} />
    </aside>
  </section>
</BaseLayout>
<style>
  .note-detail {
    display: flex;
    align-items: flex-start;
    gap: 56px;
    padding-top: 40px;
  }
  .note-main {
    min-width: 0;
    width: 100%;
    max-width: 760px;
    flex: 1;
  }
  .note-aside {
    width: 240px;
    flex-shrink: 0;
    position: sticky;
    top: 100px;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
  }
  .back-note {
    display: inline-block;
    margin: 32px 0;
    font-size: 13px;
    color: hsl(var(--primary));
  }
  @media (max-width: 1023px) {
    .note-aside {
      display: none;
    }
    .note-detail {
      padding-top: 28px;
    }
    .note-main {
      margin-inline: auto;
    }
  }
</style>
