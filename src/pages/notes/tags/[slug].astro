---
import CollectionLayout from "@components/notes/CollectionLayout.astro";
import { getNotesTagPages } from "@lib/taxonomyParser";
export async function getStaticPaths() {
  return (await getNotesTagPages())
    .filter((page) => page.params.page === "1")
    .map(({ params, props }) => ({ params: { slug: params.slug }, props }));
}
const props = Astro.props;
---

<CollectionLayout {...props} />
