---
import { Image } from "astro:assets";
import { SITE_INFO, AVATAR_IMAGE } from "@lib/config";
import BaseLayout from "@components/base/BaseLayout.astro";
import { sortByDate } from "@lib/sortFunctions";
import { getEntries } from "@lib/contentParser";
import { plainify } from "@lib/textConverter";
import ArticleCalendar from "@components/home/ArticleCalendar.astro";
import { getSeries } from "@lib/series";
import { groupReadingEntries } from "@lib/seriesModel";
import WorkCard from "@components/writings/WorkCard.astro";
import WritingsListCard from "@components/writings/WritingsListCard.astro";
import HomeArticle from "@components/home/HomeArticle.astro";
import HomeNotesPreview from "@components/notes/HomeNotesPreview.astro";

const [allPosts, allWritings, latestNotes] = await Promise.all([
  getEntries("blog", sortByDate),
  getEntries("writings", sortByDate),
  getEntries("notes", sortByDate),
]);
const readingSeries = await getSeries();
const articleSeries = readingSeries.filter(
  (item) => item.entry.data.kind === "technical",
);
const writingItems = groupReadingEntries(allWritings, readingSeries);
// 最近更新以合集/作品为单位，正文地址留给归档、搜索和订阅。
const latestEntries = groupReadingEntries(
  [...allPosts, ...allWritings],
  readingSeries,
).map((item) => {
  if (item.kind === "series") {
    const literary = item.series.entry.data.kind === "literary";
    return {
      title: item.series.entry.data.title,
      href: item.href,
      description: item.series.entry.data.description,
      created: item.updated,
      label: literary
        ? `${item.series.entry.data.genre || "文学作品"} · ${item.series.chapters.length} 章`
        : `文章合集 · ${item.series.chapters.length} 篇`,
      image: item.series.chapters[0].data.image,
      imageAlt: item.series.entry.data.title,
      cta: literary ? "查看作品" : "查看合集",
    };
  }
  const entry = item.entry;
  return {
    title: entry.data.title,
    href: item.href,
    description:
      entry.data.description || plainify(entry.body || "").slice(0, 100),
    created: item.updated,
    label:
      entry.collection === "blog"
        ? entry.data.categories?.[0] || "文章"
        : entry.data.genre || "作品",
    image: entry.data.image,
    imageAlt: entry.data.title,
  };
});
const [featured, ...recent] = latestEntries.slice(0, 5);
const topics = articleSeries.slice(0, 3).map((item, index) => ({
  title: item.entry.data.title,
  description: item.entry.data.description,
  count: item.chapters.length,
  href: item.href,
  caption: "查看章节目录",
  mark: String(index + 1).padStart(2, "0"),
}));
---

<BaseLayout>
  <div class="home-page">
    <section class="home-intro" aria-labelledby="home-title">
      <div class="intro-copy">
        <p class="eyebrow">
          <span aria-hidden="true"></span> {SITE_INFO.SITE_NAME} 的个人博客
        </p>
        <h1 id="home-title">
          读书、听歌，
          <br />
          把日子<span class="title-accent">写下来。</span>
        </h1>
        <p class="intro-description">
          我是 {SITE_INFO.AUTHOR}，喜欢阅读、音乐和写字。
          <br class="desktop-break" />
          这里放一些想法，也留一些日常。
        </p>
        <div class="intro-links">
          <a class="read-link" href="#latest">
            开始阅读 <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="/about/">
            关于我 <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <aside class="author-note" aria-label="作者名片">
        <div class="portrait-frame">
          <Image
            src={AVATAR_IMAGE}
            alt={`${SITE_INFO.AUTHOR}的头像`}
            width={240}
            height={240}
            format="webp"
            loading="eager"
            class="portrait"
          />
        </div>
        <p class="author-name">{SITE_INFO.AUTHOR}</p>
        <p class="author-motto">有空读书，也听听歌。</p>
        <div class="author-note-bottom">
          <span>文字 · 音乐 · 日常</span>
          <span aria-hidden="true">✳</span>
        </div>
      </aside>
    </section>
    <section id="latest" class="latest-section" aria-labelledby="latest-title">
      <div class="section-heading">
        <div class="section-title">
          <span class="section-index" aria-hidden="true">
            01 /
          </span>
          <h2 id="latest-title">最近更新</h2>
        </div>
        <nav class="content-links" aria-label="按内容类型阅读">
          <a class="text-link" href="/blog/">
            文章
          </a>
          {allWritings.length > 0 && (
            <a class="text-link" href="/writings/">
              创作
            </a>
          )}
          {latestNotes.length > 0 && (
            <a class="text-link" href="/notes/">
              笔记
            </a>
          )}
        </nav>
      </div>
      {featured ? (
        <div class="latest-grid">
          <HomeArticle entry={featured} featured />
          {recent.length > 0 && (
            <div class="recent-list">
              {recent.map((entry) => (
                <HomeArticle entry={entry} />
              ))}
            </div>
          )}
        </div>
      ) : (
        <p class="empty-note">故事从这里开始，新的文章正在路上。</p>
      )}
    </section>
    {topics.length > 0 && (
      <section class="topics-section" aria-labelledby="topics-title">
        <div class="topics-intro">
          <span class="section-index" aria-hidden="true">
            02 /
          </span>
          <h2 id="topics-title">
            沿着一个问题，
            <br />
            再读深一点。
          </h2>
          <p>
            把零散的笔记连起来，
            <br />
            慢慢建立自己的理解。
          </p>
          <a class="text-link" href="/series/">
            浏览系列合集 <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="topic-list">
          {topics.map((topic) => (
            <a class="topic" href={topic.href}>
              <span class="topic-number" aria-hidden="true">
                {topic.mark}
              </span>
              <div>
                <h3>{topic.title}</h3>
                <p>{topic.description}</p>
                <span class="topic-caption">
                  {topic.count} 篇文章 · {topic.caption}
                </span>
              </div>
              <span class="topic-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
    {writingItems.length > 0 && (
      <section class="writings-section" aria-labelledby="writings-title">
        <div class="section-heading">
          <div class="section-title">
            <span class="section-index" aria-hidden="true">
              03 /
            </span>
            <h2 id="writings-title">创作</h2>
          </div>
          <a class="text-link" href="/writings/">
            全部创作 <span aria-hidden="true">↗</span>
          </a>
        </div>
        {writingItems
          .slice(0, 3)
          .map((item) =>
            item.kind === "series" ? (
              <WorkCard series={item.series} />
            ) : (
              <WritingsListCard entry={item.entry} />
            ),
          )}
      </section>
    )}
    {latestNotes.length > 0 && (
      <section class="notes-section" aria-label="笔记">
        <HomeNotesPreview entries={latestNotes} limit={4} />
      </section>
    )}
    <section class="activity-record" aria-label="年度活动记录">
      <ArticleCalendar />
    </section>
  </div>
</BaseLayout>

<style>
  .content-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
  }
  .writings-section {
    margin-top: 44px;
  }
  .home-page {
    max-width: var(--site-width);
    margin-inline: auto;
    padding: 0 32px;
  }
  .home-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 248px;
    align-items: center;
    gap: 80px;
    padding: 72px 0 68px;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
    font-size: 12px;
    letter-spacing: 0.1em;
    color: hsl(var(--primary));
  }
  .eyebrow span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .home-intro h1 {
    font-family: var(--font-editorial);
    font-size: clamp(36px, 4.4vw, 60px);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.045em;
  }
  .title-accent {
    color: hsl(var(--primary));
  }
  .intro-description {
    margin-top: 22px;
    color: hsl(var(--muted-foreground));
    font-size: 15px;
    line-height: 1.9;
  }
  .intro-links {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 28px;
  }
  .read-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    border-radius: 6px;
    padding: 10px 18px;
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    font-size: 13px;
    transition:
      background 0.2s,
      transform 0.2s;
  }
  .read-link:hover {
    background: hsl(var(--primary) / 0.88);
    transform: translateY(-2px);
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    transition: color 0.2s;
  }
  .text-link:hover {
    color: hsl(var(--primary));
  }
  .author-note {
    padding: 24px 24px 0;
    background: hsl(var(--secondary) / 0.45);
    border: 1px solid hsl(var(--border) / 0.5);
    border-radius: 3px 3px 32px 3px;
    transform: rotate(3deg);
  }
  .portrait-frame {
    width: 116px;
    height: 116px;
    padding: 6px;
    border: 1px solid hsl(var(--primary) / 0.25);
    border-radius: 50%;
    margin: 4px auto 18px;
  }
  .portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }
  .author-name {
    text-align: center;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .author-motto {
    text-align: center;
    color: hsl(var(--muted-foreground));
    font-size: 12px;
    margin-top: 5px;
  }
  .author-note-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 25px;
    padding: 12px 0;
    border-top: 1px solid hsl(var(--border));
    color: hsl(var(--primary));
    font-size: 10px;
    letter-spacing: 0.1em;
  }
  .author-note-bottom > span:last-child {
    font-size: 24px;
  }
  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
    padding-top: 26px;
    border-top: 1px solid hsl(var(--border));
  }
  .section-title {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .section-index {
    color: hsl(var(--primary));
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }
  .section-heading h2 {
    font-size: 20px;
    font-weight: 600;
  }
  .latest-section {
    scroll-margin-top: 100px;
  }
  .latest-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    gap: 44px;
  }
  .recent-list {
    display: grid;
    align-content: start;
  }
  .empty-note {
    padding: 32px 0;
    color: hsl(var(--muted-foreground));
  }
  .topics-section {
    display: grid;
    grid-template-columns: 0.8fr 1.6fr;
    gap: 56px;
    margin-top: 64px;
    padding: 36px 0;
    border-top: 1px solid hsl(var(--border));
    border-bottom: 1px solid hsl(var(--border));
  }
  .topics-intro h2 {
    margin-top: 18px;
    font-family: var(--font-editorial);
    font-size: 28px;
    line-height: 1.55;
    font-weight: 600;
  }
  .topics-intro p {
    margin: 14px 0 20px;
    font-size: 13px;
    line-height: 1.9;
    color: hsl(var(--muted-foreground));
  }
  .topic {
    display: grid;
    grid-template-columns: 28px 1fr 24px;
    align-items: start;
    gap: 18px;
    padding: 21px 0;
    border-bottom: 1px solid hsl(var(--border) / 0.65);
  }
  .topic:first-child {
    padding-top: 4px;
  }
  .topic:last-child {
    border-bottom: 0;
    padding-bottom: 4px;
  }
  .topic-number {
    font-size: 11px;
    color: hsl(var(--muted-foreground));
    font-variant-numeric: tabular-nums;
  }
  .topic h3 {
    font-size: 18px;
    line-height: 1.5;
    transition: color 0.2s;
  }
  .topic p {
    margin-top: 5px;
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    line-height: 1.8;
  }
  .topic-caption {
    display: block;
    margin-top: 9px;
    font-size: 11px;
    color: hsl(var(--primary));
  }
  .topic-arrow {
    color: hsl(var(--primary));
    transition: transform 0.2s;
  }
  .topic:hover h3 {
    color: hsl(var(--primary));
  }
  .topic:hover .topic-arrow {
    transform: translate(3px, -3px);
  }
  .notes-section {
    border-top: 1px solid hsl(var(--border));
    padding: 24px 0;
  }
  .activity-record {
    margin-top: 22px;
    padding: 24px;
    background: hsl(var(--secondary) / 0.3);
    border-radius: 10px;
  }
  .home-page a:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 5px;
    border-radius: 4px;
  }
  .home-page a:active {
    transform: translateY(1px);
  }
  @media (max-width: 1023px) {
    .home-intro {
      gap: 36px;
      grid-template-columns: minmax(0, 1fr) 210px;
      padding-block: 48px;
    }
    .latest-grid {
      gap: 28px;
    }
    .topics-section {
      gap: 32px;
    }
  }
  @media (max-width: 767px) {
    .home-page {
      padding-inline: 22px;
    }
    .home-intro {
      grid-template-columns: 1fr;
      padding: 40px 0;
      gap: 30px;
    }
    .home-intro h1 {
      font-size: clamp(34px, 7.8vw, 48px);
    }
    .eyebrow {
      margin-bottom: 16px;
      font-size: 11px;
    }
    .intro-description {
      font-size: 14px;
      margin-top: 16px;
    }
    .desktop-break {
      display: none;
    }
    .intro-links {
      margin-top: 22px;
    }
    .author-note {
      display: none;
    }
    .latest-grid {
      grid-template-columns: 1fr;
      gap: 26px;
    }
    .section-heading h2 {
      font-size: 18px;
    }
    .section-heading {
      padding-top: 22px;
    }
    .topics-section {
      grid-template-columns: 1fr;
      gap: 28px;
      margin-top: 36px;
      padding-block: 28px;
    }
    .topics-intro h2 {
      font-size: 26px;
      margin-top: 10px;
    }
    .topics-intro p {
      margin-block: 10px;
    }
    .topic {
      gap: 10px;
      grid-template-columns: 22px 1fr 20px;
    }
    .topic h3 {
      font-size: 17px;
    }
    .activity-record {
      padding: 18px 16px;
      margin-top: 8px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-page a,
    .topic-arrow,
    .topic h3 {
      transition: none;
    }
    .home-page a:hover,
    .home-page a:active,
    .topic:hover .topic-arrow {
      transform: none;
    }
  }
</style>
