---
import type { GetStaticPaths, Page } from "astro";
import CollectionLayout from "@components/blog/CollectionLayout.astro";
import { getTaxa, getTaxaWithCount } from "@lib/taxonomyParser";
import { getEntries, getIndex } from "@lib/contentParser";
import { sortByDate } from "@lib/sortFunctions";
import { getPageSize } from "@lib/config";
import type { BlogEntry } from "@/types";

export const getStaticPaths = (async ({ paginate }) => {
  const entries = await getEntries("blog", sortByDate);
  return paginate(entries, { pageSize: getPageSize("blog") })
    .filter(({ params }) => params.page !== "1");
}) satisfies GetStaticPaths;

interface Props {
  page: Page<BlogEntry>;
}

const { page } = Astro.props;
const currentPageIndex = page.currentPage;
const entryIndex = (await getIndex("blog")) as BlogEntry;
const allBlogCount = page.total;

const categoriesWithCount = await getTaxaWithCount("blog", "categories");
const tags = await getTaxa("blog", "tags");

const currentEntries = page.data;
const pageCount = page.lastPage;
---

<CollectionLayout
  entryIndex={entryIndex}
  entries={currentEntries}
  categories={categoriesWithCount}
  tags={tags}
  pageIndex={currentPageIndex}
  pageCount={pageCount}
  allBlogCount={allBlogCount}
/>
