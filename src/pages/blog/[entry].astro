---
import { getCollection, type CollectionEntry, render } from "astro:content";
import EntryLayout from "@components/blog/EntryLayout.astro";
import { isPublishedEntry } from "@lib/contentParser";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog", isPublishedEntry);

  const paths = blogEntries.map((entry) => ({
    params: { entry: entry.id },
    props: { entry },
  }));

  return paths;
}

interface Props {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<EntryLayout entry={entry}>
  <Content />
</EntryLayout>
