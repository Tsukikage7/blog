---
import TaxaLayout from "@components/blog/TaxaLayout.astro";
import { getEntries } from "@lib/contentParser";

const taxonomy = "tags";
const title = "标签";

const allPosts = await getEntries("blog");

let allTaxa: string[] = [];
allPosts.forEach((post) => {
  if (post.data.tags && Array.isArray(post.data.tags)) {
    post.data.tags.forEach((tag) => {
      allTaxa.push(tag);
    });
  }
});

const taxa = [...new Set(allTaxa)].sort((a, b) => a.localeCompare(b));
---

<TaxaLayout
  taxonomy={taxonomy}
  taxonomyTitle={title}
  taxa={taxa}
  allTaxa={allTaxa}
/>
