{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "account_id": "f08770d5c92bef6310b2e5dbf2ac2286",
  "compatibility_date": "2025-03-25",
  "routes": [
    { "pattern": "tsukikage7.com", "custom_domain": true },
    { "pattern": "www.tsukikage7.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
