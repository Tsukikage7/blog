{
  "name": "blog",
  "version": "0.0.1",
  "type": "module",
  "description": "A modern blog built with Astro.",
  "author": "Tsukikage7",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tsukikage7/blog.git"
  },
  "homepage": "https://github.com/Tsukikage7/blog#readme",
  "bugs": {
    "url": "https://github.com/Tsukikage7/blog/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm run sync:github && pnpm run build:fonts && astro dev",
    "build": "pnpm run build:prod",
    "build:fast": "pnpm run sync:github && pnpm run build:fonts && NODE_ENV=development NODE_OPTIONS='--max-old-space-size=4096' astro build",
    "build:prod": "pnpm run sync:github && pnpm run build:fonts && NODE_ENV=production NODE_OPTIONS='--max-old-space-size=4096' astro build",
    "build:fonts": "pnpm run font:analyze && pnpm run font:subset",
    "format": "prettier -w ./src",
    "preview": "astro preview",
    "serve": "astro preview",
    "clean": "rm -rf dist",
    "build:analyze": "pnpm run sync:github && pnpm run build:fonts && NODE_OPTIONS='--max-old-space-size=4096' astro build --verbose",
    "font:analyze": "node scripts/analyze-font-usage.js",
    "font:subset": "node scripts/build-font-subset.js",
    "deploy": "pnpm run build && wrangler deploy",
    "sync:github": "node scripts/sync-github-activity.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/react": "^7.0.0",
    "@astrojs/rss": "^4.0.19",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "astro": "^7.3.5",
    "astro-auto-import": "^0.6.0",
    "astro-seo": "^1.2.0",
    "astro-tooltips": "^0.6.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "fuse.js": "^7.5.0",
    "github-slugger": "^2.0.0",
    "katex": "^0.19.0",
    "marked": "^18.0.14",
    "mermaid": "^12.1.0",
    "oxc-transform-react": "^0.145.0",
    "plyr": "^3.8.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-lite-youtube-embed": "^3.7.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "remark-collapse": "^0.1.2",
    "remark-math": "^6.0.0",
    "remark-toc": "^9.0.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unist": "^3.0.3",
    "glob": "^13.0.6",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "subset-font": "^2.9.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  }
}
